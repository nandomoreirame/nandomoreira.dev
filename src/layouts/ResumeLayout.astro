---
import { absoluteUrl, requireSite } from '../lib/aeo/urls';
import { metaDescription } from '../lib/seo/meta';
import sansBodyFont from '../assets/fonts/inter-latin-variable.woff2?url';
import { ogLocale, type Locale } from '../lib/i18n/locale';
import { routeFor } from '../lib/i18n/routes';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  locale?: Locale;
}

const { title, description, locale = 'pt-BR' } = Astro.props;
// Container tests may omit Astro.site; production always has config.site.
const site = Astro.site ? requireSite(Astro.site) : new URL('https://nandomoreira.dev');
const ptPath = routeFor('/curriculo', 'pt-BR');
const enPath = routeFor('/curriculo', 'en');
const alternateLocale = locale === 'en' ? 'pt-BR' : 'en';
---

<!doctype html>
{/* A resume is a sheet of paper: the Paper theme is fixed here, with no theme
    boot and no site chrome (header, footer, palette, pointer field). */}
<html lang={locale} data-theme="paper">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16.png" type="image/png" sizes="16x16" />
    <title>{title}</title>
    <meta name="description" content={metaDescription(description)} />
    <meta name="robots" content="noindex" />
    <meta property="og:locale" content={ogLocale(locale)} />
    <meta property="og:locale:alternate" content={ogLocale(alternateLocale)} />
    <link rel="alternate" hreflang="pt-BR" href={absoluteUrl(site, ptPath)} />
    <link rel="alternate" hreflang="en" href={absoluteUrl(site, enPath)} />
    <link rel="alternate" hreflang="x-default" href={absoluteUrl(site, ptPath)} />
    <link rel="preload" href={sansBodyFont} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <div class="min-h-dvh bg-surface-elevated print:bg-background">
      <slot />
    </div>
  </body>
</html>
