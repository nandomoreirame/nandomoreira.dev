---
import { serialiseJsonLd } from '../lib/aeo/json-ld';
import { absoluteUrl } from '../lib/aeo/urls';
import { ogImagePath } from '../lib/og/pages';
import { metaDescription } from '../lib/seo/meta';
import { SALES_HOST_LIVE, salesPath, salesUrl } from '../lib/sales/host';
import { serviceLd } from '../lib/sales/service-ld';
import { contactGoPath } from '../lib/analytics/outbound';
import FloatingActions from '../components/sales/FloatingActions.astro';
import PointerField from '../components/art/PointerField.astro';
import serifHeadingFont from '../assets/fonts/newsreader-latin-variable.woff2?url';
import sansBodyFont from '../assets/fonts/inter-latin-variable.woff2?url';
import { THEME_BOOT_SCRIPT } from '../lib/theme/boot';
import { salesSlugIn } from '../lib/sales/i18n';
import { salesLabelsFor } from '../lib/sales/ui';
import { htmlLang, ogLocale, type Locale } from '../lib/i18n/locale';
import { EN_PUBLISHED } from '../lib/i18n/live';
import LanguageSwitch from '../components/layout/LanguageSwitch.astro';
import { salesWhatsappPath } from '../lib/sales/contact';
import '../styles/global.css';

interface Props {
  locale?: Locale;
  live?: boolean;
  /** Sales host state; defaults to the build flag, overridden by tests. */
  salesLive?: boolean;
  title: string;
  description: string;
  /** Detail page slug; absent on the landing. */
  slug?: string;
  /** Service name for the JSON-LD; defaults to the page title. */
  serviceName?: string;
}

const { title, description, slug, serviceName, locale = 'pt-BR', live = EN_PUBLISHED, salesLive = SALES_HOST_LIVE } = Astro.props;
const t = salesLabelsFor(locale);
const target: Locale = locale === 'en' ? 'pt-BR' : 'en';
const ptSlug = slug ? salesSlugIn(slug, 'pt-BR') : undefined;
const enSlug = slug ? salesSlugIn(slug, 'en') : undefined;
const alternates = live ? { 'pt-BR': salesPath(ptSlug, salesLive), en: salesPath(enSlug, salesLive, 'en') } : undefined;
const canonical = salesUrl(slug, SALES_HOST_LIVE, locale);
// The share cards live on the main host under the internal path.
const ogImage = absoluteUrl(new URL('https://nandomoreira.dev'), ogImagePath(salesPath(slug, false, locale)));
const jsonLd = serialiseJsonLd(serviceLd({ name: serviceName ?? title, description, url: canonical, locale }));
const home = salesPath(undefined, SALES_HOST_LIVE, locale);
// Every sales page closes with its own form (#contato).
const contact = '#contato';
const year = new Date().getUTCFullYear();

const NAV = [
  { href: `${home}#servicos`, label: t.services },
  { href: `${home}#como-trabalho`, label: t.steps },
  { href: `${home}#projetos`, label: t.projects },
  { href: `${home}#duvidas`, label: t.questions },
];
const link =
  'inline-flex min-h-11 items-center text-small text-muted-foreground transition-[color] duration-(--duration-fast) ease-out hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary';
---

<!doctype html>
<html lang={htmlLang(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    {/* Theme boot (theme-modes): blocking on purpose, so the stored theme is
        on <html> before the first paint, on pre-rendered routes too. */}
    <script is:inline set:html={THEME_BOOT_SCRIPT} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16.png" type="image/png" sizes="16x16" />
    <title>{title}</title>
    <meta name="description" content={metaDescription(description)} />
    <link rel="canonical" href={canonical} />
    <meta property="og:locale" content={ogLocale(locale)} />
    {live && <meta property="og:locale:alternate" content={ogLocale(target)} />}
    {alternates && (<>
      <link rel="alternate" hreflang="pt-BR" href={salesUrl(ptSlug)} />
      <link rel="alternate" hreflang="en" href={salesUrl(enSlug, SALES_HOST_LIVE, 'en')} />
      <link rel="alternate" hreflang="x-default" href={salesUrl(ptSlug)} />
    </>)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" is:inline set:html={jsonLd} />
    <link rel="preload" href={serifHeadingFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansBodyFont} as="font" type="font/woff2" crossorigin />
  </head>
  <body data-pointer-field>
    <div id="topo"></div>
    <a
      href="#main"
      class="sr-only focus-visible:not-sr-only focus-visible:absolute focus-visible:top-md focus-visible:left-md focus-visible:z-50 focus-visible:rounded-md focus-visible:bg-primary focus-visible:px-md focus-visible:py-sm focus-visible:text-primary-foreground"
    >
      {t.skipToContent}
    </a>

    <header
      data-site-header
      class="group sticky top-0 z-40 border-b border-border transition-[background-color] duration-(--duration-base) ease-out data-scrolled:bg-background/80 data-scrolled:backdrop-blur-lg"
    >
      <div class="mx-auto flex w-full max-w-page items-center justify-between gap-md px-lg py-md transition-[padding] duration-(--duration-base) ease-out group-data-scrolled:py-xs">
        <a href={home} class="inline-flex min-h-11 items-center gap-xs font-mono text-body font-semibold text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
          <span class="size-2 rounded-full bg-primary" aria-hidden="true"></span>
          nandomoreira.dev
        </a>
        <nav aria-label={t.sections} class="hidden md:block">
          <ul class="flex items-center gap-lg">
            {NAV.map((item) => <li><a href={item.href} class={link}>{item.label}</a></li>)}
          </ul>
        </nav>
        <LanguageSwitch locale={locale} alternates={alternates} live={live} />
        <a
          href={contact}
          class="inline-flex min-h-11 items-center rounded-md bg-primary px-md text-small font-medium text-primary-foreground transition-[min-height] duration-(--duration-base) ease-out group-data-scrolled:min-h-9 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
          {t.budget}
        </a>
      </div>
    </header>

    <main id="main" tabindex="-1" class="focus:outline-none">
      <slot />
    </main>

    <footer class="border-t border-border">
      <div class="mx-auto flex w-full max-w-page flex-col gap-md px-lg py-xl md:flex-row md:items-center md:justify-between">
        <p class="text-small text-muted-foreground">
          <span class="font-mono font-semibold text-foreground">nandomoreira.dev</span>
          · © {year} {t.footer}
        </p>
        <ul class="flex flex-wrap gap-md">
          <li><a class={link} href={locale === 'en' ? 'https://nandomoreira.dev/en' : 'https://nandomoreira.dev'}>{t.personalSite}</a></li>
          <li><a class={link} href={salesWhatsappPath(locale)}>WhatsApp</a></li>
          <li><a class={link} href={contactGoPath('linkedin')}>LinkedIn</a></li>
          <li><a class={link} href={locale === 'en' ? 'https://nandomoreira.dev/en/privacy' : 'https://nandomoreira.dev/privacidade'}>{t.privacy}</a></li>
        </ul>
      </div>
    </footer>
    <FloatingActions locale={locale} />
    <PointerField />
  </body>
</html>
