---
import AiSwitcher from '../components/ai-view/AiSwitcher.astro';
import PointerField from '../components/art/PointerField.astro';
import CommandPalette from '../components/search/CommandPalette.astro';
import { aiPathFor, mdPathFor } from '../lib/ai-view/paths';
import PaletteTrigger from '../components/search/PaletteTrigger.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import { loadSiteCommits } from '../lib/history/commits';
import { siteVersionTag } from '../lib/history/history';
import SiteHeader from '../components/layout/SiteHeader.astro';
import { serialiseJsonLd } from '../lib/aeo/json-ld';
import { absoluteUrl, canonicalUrl, pagePath, requireSite } from '../lib/aeo/urls';
import { metaDescription } from '../lib/seo/meta';
import { ogImagePath } from '../lib/og/pages';
import serifHeadingFont from '../assets/fonts/newsreader-latin-variable.woff2?url';
import sansBodyFont from '../assets/fonts/inter-latin-variable.woff2?url';
import { webPageLd, type PageType } from '../lib/aeo/webpage-ld';
import { displayNameOf } from '../lib/content/display-name';
import { websiteLd } from '../lib/aeo/website-ld';
import { showsPixel } from '../lib/analytics/pixel-placement';
import { getAllPosts, getProfile } from '../lib/content';
import { profileUrls } from '../lib/home/person-ld';
import { THEME_BOOT_SCRIPT } from '../lib/theme/boot';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Absolute or root-relative URL of the markdown alternate for this page. */
  markdownAlternate?: string;
  /** Which side of the Humano | IA switcher is current. */
  view?: 'human' | 'ai';
  /** Root-relative path used for the canonical URL when it differs from the request. */
  canonicalPath?: string;
  /** schema.org type of the page: ProfilePage for /sobre, CollectionPage for listings. */
  pageType?: PageType;
  /** Root-relative paths a CollectionPage lists, in order. */
  pageItems?: string[];
  /** Main-menu item this page belongs to when its path does not say so (a post lives at the root). */
  section?: string;
}

const {
  title,
  description,
  noindex = false,
  markdownAlternate,
  view,
  canonicalPath,
  pageType,
  pageItems,
  section,
} = Astro.props;
const current = Astro.url?.pathname ? pagePath(Astro.url.pathname) : undefined;
// Container tests may omit Astro.site; production always has config.site.
const site = Astro.site ? requireSite(Astro.site) : new URL('https://nandomoreira.dev');
const canonical = canonicalUrl(site, canonicalPath ?? current ?? '/');
// Noindex pages (the AI view, the 404) share the home card.
const ogImage = absoluteUrl(site, ogImagePath(noindex ? '/' : new URL(canonical).pathname));
const websiteJsonLd = serialiseJsonLd(websiteLd(site, 'nandomoreira.dev'));
const webPageJsonLd = serialiseJsonLd(
  webPageLd({ site, path: new URL(canonical).pathname, title, description, type: pageType, items: pageItems }),
);
const [profile, posts] = await Promise.all([getProfile(), getAllPosts()]);
// Year is fixed at build time so the footer stays reproducible across deploys.
const year = new Date().getUTCFullYear();
const version = siteVersionTag(await loadSiteCommits());
const hasPosts = posts.length > 0;
// 404 is noindex without a view; every other page shows the switcher.
const showSwitcher = !(noindex && view === undefined);
const switcherHumanPath = canonicalPath ? pagePath(canonicalPath) : (current ?? '/');
const switcherView = view ?? 'human';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    {/* Theme boot (theme-modes): blocking on purpose, so the stored theme is
        on <html> before the first paint, on pre-rendered routes too. */}
    <script is:inline set:html={THEME_BOOT_SCRIPT} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={metaDescription(description)} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {/* Identity (IndieAuth, Mastodon verification): the visible profile
        links go through /go, so the rel=me assertion lives here. */}
    {profileUrls(profile.contacts).map((url) => <link rel="me" href={url} />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="alternate" type="application/rss+xml" href="/rss.xml" title="Blog de Fernando Moreira" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM summary" />
    <link
      rel="alternate"
      type="text/plain"
      href="/llms-full.txt"
      title="LLM full content"
    />
    <link
      rel="alternate"
      type="application/json"
      href="/ai-index.json"
      title="AI index"
    />
    {
      markdownAlternate && (
        <link rel="alternate" type="text/markdown" href={markdownAlternate} />
      )
    }
    <script type="application/ld+json" is:inline set:html={websiteJsonLd} />
    <script type="application/ld+json" is:inline set:html={webPageJsonLd} />
    {/* Two preloads, one per visible-above-the-fold job: the serif at 600 paints
        the headline (every h1 is semibold, the LCP candidate), the sans paints
        the body around it. Imported, so the URL carries the content hash. */}
    <link
      rel="preload"
      href={serifHeadingFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={sansBodyFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body data-pointer-field>
    {/* The body is the pointer field: the dot grid and its glow cover every
        page, behind everything (generative-case-art, amendment 2). */}
    <a
      href="#main"
      class="sr-only focus-visible:not-sr-only focus-visible:absolute focus-visible:top-md focus-visible:left-md focus-visible:z-50 focus-visible:rounded-md focus-visible:bg-primary focus-visible:px-md focus-visible:py-sm focus-visible:text-primary-foreground"
    >
      Pular para o conteúdo
    </a>

    {/* The AI view swaps the human header for its own bar (docs/specs/ai-view). */}
    {
      view === 'ai' ? (
        <slot name="top" />
      ) : (
        <SiteHeader
          name={profile.wordmark ?? profile.name}
          accent="moreira"
          current={current}
          section={section}
          hasPosts={hasPosts}
          availability={profile.availability}
        />
      )
    }

    <div class="mx-auto w-full max-w-page px-lg">
      <main id="main" tabindex="-1" class="focus:outline-none">
        <slot />
      </main>
    </div>

    <SiteFooter name={displayNameOf(profile)} year={year} contacts={profile.contacts} version={version} />
    {/* Bottom-right corner stack: the palette trigger above the AI switcher. */}
    <div data-corner-actions data-reader-hide class="fixed right-lg bottom-lg z-10 flex flex-col items-end gap-sm">
      <PaletteTrigger />
      {showSwitcher && <AiSwitcher humanPath={switcherHumanPath} view={switcherView} />}
    </div>
    <CommandPalette
      mdPath={showSwitcher ? mdPathFor(switcherHumanPath) : undefined}
      aiPath={showSwitcher && switcherView === 'human' ? aiPathFor(switcherHumanPath) : undefined}
      humanPath={showSwitcher && switcherView === 'ai' ? switcherHumanPath : undefined}
    />
    <PointerField />
    {
      showsPixel({ isPrerendered: Astro.isPrerendered, view }) && (
        <img
          src="/v.gif"
          alt=""
          width="1"
          height="1"
          aria-hidden="true"
          decoding="async"
          referrerpolicy="strict-origin-when-cross-origin"
          class="pointer-events-none absolute size-px opacity-0"
        />
      )
    }
  </body>
</html>
