---
import AiSwitcher from '../components/ai-view/AiSwitcher.astro';
import PointerField from '../components/art/PointerField.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import { serialiseJsonLd } from '../lib/aeo/json-ld';
import { requireSite } from '../lib/aeo/urls';
import { websiteLd } from '../lib/aeo/website-ld';
import { getAllPosts, getProfile } from '../lib/content';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Absolute or root-relative URL of the markdown alternate for this page. */
  markdownAlternate?: string;
  /** Which side of the Humano | IA switcher is current. */
  view?: 'human' | 'ai';
  /** Root-relative path used for the canonical URL when it differs from the request. */
  canonicalPath?: string;
}

const {
  title,
  description,
  noindex = false,
  markdownAlternate,
  view,
  canonicalPath,
} = Astro.props;
const current = Astro.url?.pathname;
// Container tests may omit Astro.site; production always has config.site.
const site = Astro.site ? requireSite(Astro.site) : new URL('https://nandomoreira.dev');
const canonical = new URL(canonicalPath ?? Astro.url?.pathname ?? '/', site).toString();
const websiteJsonLd = serialiseJsonLd(websiteLd(site, 'nandomoreira.dev'));
const [profile, posts] = await Promise.all([getProfile(), getAllPosts()]);
// Year is fixed at build time so the footer stays reproducible across deploys.
const year = new Date().getUTCFullYear();
const hasPosts = posts.length > 0;
// 404 is noindex without a view; every other page shows the switcher.
const showSwitcher = !(noindex && view === undefined);
const switcherHumanPath = canonicalPath ?? current ?? '/';
const switcherView = view ?? 'human';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM summary" />
    <link
      rel="alternate"
      type="text/plain"
      href="/llms-full.txt"
      title="LLM full content"
    />
    <link
      rel="alternate"
      type="application/json"
      href="/ai-index.json"
      title="AI index"
    />
    {
      markdownAlternate && (
        <link rel="alternate" type="text/markdown" href={markdownAlternate} />
      )
    }
    <script type="application/ld+json" is:inline set:html={websiteJsonLd} />
    {/* Two preloads, one per visible-above-the-fold job: the serif paints the
        headline (the LCP candidate), the sans paints the body around it. */}
    <link
      rel="preload"
      href="/fonts/literata-latin-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/alegreya-sans-latin-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body data-pointer-field>
    {/* The body is the pointer field: the dot grid and its glow cover every
        page, behind everything (generative-case-art, amendment 2). */}
    <a
      href="#main"
      class="sr-only focus-visible:not-sr-only focus-visible:absolute focus-visible:top-md focus-visible:left-md focus-visible:z-10 focus-visible:rounded-md focus-visible:bg-primary focus-visible:px-md focus-visible:py-sm focus-visible:text-primary-foreground"
    >
      Pular para o conteúdo
    </a>

    <SiteHeader
      name={profile.wordmark ?? profile.name}
      accent="moreira"
      current={current}
      hasPosts={hasPosts}
    />

    <div class="mx-auto w-full max-w-page px-lg">
      <main id="main" tabindex="-1">
        <slot />
      </main>
    </div>

    <SiteFooter name={profile.name} year={year} contacts={profile.contacts} />
    {
      showSwitcher && (
        <AiSwitcher humanPath={switcherHumanPath} view={switcherView} />
      )
    }
    <PointerField />
  </body>
</html>
