---
import SiteNav from '../components/layout/SiteNav.astro';
import { serialiseJsonLd } from '../lib/aeo/json-ld';
import { requireSite } from '../lib/aeo/urls';
import { websiteLd } from '../lib/aeo/website-ld';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const current = Astro.url?.pathname;
// Container tests may omit Astro.site; production always has config.site.
const site = Astro.site ? requireSite(Astro.site) : new URL('https://nandomoreira.dev');
const canonical = new URL(Astro.url?.pathname ?? '/', site).toString();
const websiteJsonLd = serialiseJsonLd(websiteLd(site, 'nandomoreira.dev'));
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <script type="application/ld+json" is:inline set:html={websiteJsonLd} />
    <link
      rel="preload"
      href="/fonts/inter-latin-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus-visible:not-sr-only focus-visible:absolute focus-visible:top-md focus-visible:left-md focus-visible:z-10 focus-visible:rounded-md focus-visible:bg-primary focus-visible:px-md focus-visible:py-sm focus-visible:text-primary-foreground"
    >
      Pular para o conteúdo
    </a>

    <div class="mx-auto w-full max-w-page px-md">
      <SiteNav current={current} />
      <main id="main" tabindex="-1">
        <slot />
      </main>
    </div>
  </body>
</html>
