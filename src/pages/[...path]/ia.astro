---
import { TITLE_SEPARATOR } from '../../lib/seo/meta';
import AiBar from '../../components/ai-view/AiBar.astro';
import AiDocument from '../../components/ai-view/AiDocument.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { absoluteUrl, requireSite } from '../../lib/aeo/urls';
import { markdownForPath } from '../../lib/ai-view/registry';
import { displayNameOf } from '../../lib/content/display-name';
import { getProfile } from '../../lib/content';
import { localeOfPath } from '../../lib/i18n/locale';
import { messagesFor } from '../../lib/i18n/messages';

export const prerender = false;

const site = requireSite(Astro.site ?? new URL('https://nandomoreira.dev'));
const pathKey = Astro.params.path ?? '';
const page = await markdownForPath(site, pathKey);

// The catch-all would answer 200 for any path; the registry is the source of
// truth for which pages have an AI view.
if (!page) {
  Astro.response.status = 404;
}

const locale = localeOfPath(page?.humanPath ?? (pathKey === '' ? '/' : `/${pathKey}`));
const t = messagesFor(locale).aiView;
const authorName = displayNameOf(await getProfile(locale));
---

{
  !page ? (
    <p>Not found</p>
  ) : (
    <BaseLayout
      title={`${page.title}${TITLE_SEPARATOR}${t.titleTag}${TITLE_SEPARATOR}${authorName}`}
      description={t.viewOf(page.humanPath)}
      noindex
      view="ai"
      canonicalPath={page.humanPath}
      markdownAlternate={page.mdPath}
      locale={locale}
    >
      <AiBar slot="top" humanPath={page.humanPath} mdPath={page.mdPath} locale={locale} />
      <AiDocument
        title={page.title}
        url={absoluteUrl(site, page.humanPath)}
        markdown={page.markdown}
        locale={locale}
      />
    </BaseLayout>
  )
}
