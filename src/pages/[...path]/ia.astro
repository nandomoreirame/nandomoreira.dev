---
import { TITLE_SEPARATOR } from '../../lib/seo/meta';
import AiBar from '../../components/ai-view/AiBar.astro';
import AiDocument from '../../components/ai-view/AiDocument.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { absoluteUrl, requireSite } from '../../lib/aeo/urls';
import { markdownForPath } from '../../lib/ai-view/registry';
import { displayNameOf } from '../../lib/content/display-name';
import { getProfile } from '../../lib/content';

export const prerender = false;

const site = requireSite(Astro.site ?? new URL('https://nandomoreira.dev'));
const page = await markdownForPath(site, Astro.params.path ?? '');

// The catch-all would answer 200 for any path; the registry is the source of
// truth for which pages have an AI view.
if (!page) {
  Astro.response.status = 404;
}

const authorName = displayNameOf(await getProfile());
---

{
  !page ? (
    <p>Not found</p>
  ) : (
    <BaseLayout
      title={`${page.title}${TITLE_SEPARATOR}IA${TITLE_SEPARATOR}${authorName}`}
      description={`Visão IA de ${page.humanPath}`}
      noindex
      view="ai"
      canonicalPath={page.humanPath}
      markdownAlternate={page.mdPath}
    >
      <AiBar slot="top" humanPath={page.humanPath} mdPath={page.mdPath} />
      <AiDocument
        title={page.title}
        url={absoluteUrl(site, page.humanPath)}
        markdown={page.markdown}
      />
    </BaseLayout>
  )
}
