---
import PageHeader from '../components/ui/PageHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

Astro.response.status = 404;
---

<BaseLayout
  title="Página não encontrada | nandomoreira.dev"
  description="A página solicitada não existe."
  noindex
>
  <PageHeader
    eyebrow="Erro 404"
    title="Página não encontrada"
    description="O endereço acessado não corresponde a nenhuma página deste site."
  />
  <a href="/portfolio" class="text-body text-primary underline">Ver o portfólio</a>
</BaseLayout>
