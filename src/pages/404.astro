---
import PageHeader from '../components/ui/PageHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { displayNameOf } from '../lib/content/display-name';
import { getProfile } from '../lib/content';

Astro.response.status = 404;

const authorName = displayNameOf(await getProfile());
---

<BaseLayout
  title={`Página não encontrada | ${authorName}`}
  description="A página solicitada não existe."
  noindex
>
  <PageHeader
    eyebrow="Erro 404"
    title="Página não encontrada"
    description="O endereço acessado não corresponde a nenhuma página deste site."
  />
  <a href="/portfolio" class="text-body text-primary underline">Ver o portfólio</a>
</BaseLayout>
