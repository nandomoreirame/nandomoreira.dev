---
import ListRow from '../../../components/ui/ListRow.astro';
import SectionHeader from '../../../components/ui/SectionHeader.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getArchiveYears } from '../../../lib/content';

const years = await getArchiveYears();
---

<BaseLayout
  title="Arquivo | nandomoreira.dev"
  description="Textos arquivados, agrupados por ano de publicação."
>
  <h1 class="mt-2xl mb-xl text-h1 font-semibold text-foreground">Arquivo</h1>

  <SectionHeader title="Anos" level={2} count={years.length} />

  {
    years.length === 0 ? (
      <p class="rounded-md border border-border bg-surface p-lg text-body text-muted-foreground">
        Nenhum texto arquivado ainda.
      </p>
    ) : (
      <ul class="list-none p-0">
        {years.map((year) => (
          <li>
            <ListRow
              href={`/posts/arquivo/${year.year}`}
              title={year.year}
              summary={`${year.count} ${year.count === 1 ? 'texto' : 'textos'}`}
            />
          </li>
        ))}
      </ul>
    )
  }

  <p class="mt-2xl mb-3xl text-body text-muted-foreground">
    <a
      href="/posts"
      class="text-primary underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
    >
      Voltar aos posts correntes
    </a>
  </p>
</BaseLayout>
