---
import ListRow from '../../../components/ui/ListRow.astro';
import PageHeader from '../../../components/ui/PageHeader.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getArchivedPostsByYear, getArchiveYears } from '../../../lib/content';
import { toCompactStamp } from '../../../lib/format/date';

export const prerender = true;

export async function getStaticPaths() {
  const years = await getArchiveYears();

  return years.map(({ year }) => ({
    params: { year },
    props: { year },
  }));
}

interface Props {
  year: string;
}

const { year } = Astro.props as Props;
// getStaticPaths only emits years with count > 0, so the list is never empty here.
const posts = await getArchivedPostsByYear(year);
---

<BaseLayout
  title={`Arquivo ${year} | nandomoreira.dev`}
  description={`Textos publicados em ${year}.`}
>
  <nav class="mt-lg" aria-label="Trilha de navegação">
    <a
      href="/posts/arquivo"
      class="inline-flex min-h-11 items-center gap-xs font-mono text-small text-muted-foreground transition-[color] duration-(--duration-fast) ease-out hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
    >
      <span aria-hidden="true">←</span>
      Arquivo
    </a>
  </nav>

  <PageHeader
    eyebrow="Arquivo"
    title={`Textos de ${year}`}
    description={`${posts.length === 1 ? 'Um texto publicado' : `${posts.length} textos publicados`} em ${year}, mantidos como registro com a data à vista.`}
  />

  <ul class="mb-3xl list-none p-0">
    {
      posts.map((post) => (
        <li>
          <ListRow
            href={`/${post.slug}`}
            title={post.title}
            summary={post.summary}
            markers={post.markers}
            stamp={toCompactStamp(post.date)}
          />
        </li>
      ))
    }
  </ul>
</BaseLayout>
