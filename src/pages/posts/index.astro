---
import PostsPage from '../../components/pages/PostsPage.astro';
import { SESSION_COOKIE } from '../../lib/http/session-cookie';
import { listingHref, parseListingView } from '../../lib/posts/listing-view';
import { parsePage } from '../../lib/posts/paginate';

// A leftover ?visao= from the first version of the toggle must not stay in the
// address bar. The cookie, not the query, decides the view.
const requestedPage = parsePage(Astro.url.searchParams.get('pagina'));
if (Astro.url.searchParams.has('visao')) {
  return Astro.redirect(listingHref(requestedPage));
}

// Personalized by the cookie, so a shared or browser cache must not reuse it.
Astro.response.headers.set('Cache-Control', 'private, no-store');

const view = parseListingView(Astro.cookies.get(SESSION_COOKIE)?.value);
---

<PostsPage locale="pt-BR" view={view} />
