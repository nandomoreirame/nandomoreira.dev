---
import ListRow from '../../components/ui/ListRow.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import UpcomingPosts from '../../components/posts/UpcomingPosts.astro';
import { getCurrentPosts, getUpcomingPosts } from '../../lib/content';
import { toCompactStamp } from '../../lib/format/date';

const posts = await getCurrentPosts();
const upcoming = await getUpcomingPosts();
---

<BaseLayout
  title="Posts | nandomoreira.dev"
  description="Textos correntes sobre engenharia, tooling e agentes."
>
  <PageHeader
    eyebrow="Posts"
    title="O que aprendi construindo"
    description="Textos práticos sobre desenvolvimento, ferramentas e fluxo de trabalho. Os textos de 2015 a 2019 ficam no arquivo, organizados por ano."
  />

  {
    posts.length === 0 ? (
      <p class="rounded-md border border-border bg-surface p-lg text-body text-muted-foreground">
        Nenhum post corrente no momento.
      </p>
    ) : (
      <ul class="list-none p-0">
        {posts.map((post) => (
          <li>
            <ListRow
              href={`/${post.slug}`}
              title={post.title}
              summary={post.summary}
              markers={post.markers}
              badge={post.draft ? 'Rascunho' : undefined}
              stamp={toCompactStamp(post.date)}
            />
          </li>
        ))}
      </ul>
    )
  }

  <UpcomingPosts titles={upcoming.map((post) => post.title)} />

  <p class="mt-2xl mb-3xl text-body text-muted-foreground">
    <a
      href="/posts/arquivo"
      class="text-primary underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
    >
      Arquivo por ano
    </a>
  </p>
</BaseLayout>
