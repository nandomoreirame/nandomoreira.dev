---
import Button from '../components/ui/Button.astro';
import Prose from '../components/ui/Prose.astro';
import TechBadge from '../components/ui/TechBadge.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProfile } from '../lib/content';

const profile = await getProfile();
const email = profile.contacts.find((contact) => contact.kind === 'email');
---

<BaseLayout
  title={`Sobre | ${profile.name}`}
  description={profile.headline}
>
  <article class="mt-2xl mb-3xl">
    {
      /* Eyebrow, then the claim. The name is already the wordmark on every
         page, so spending the display size on it again says nothing. No rule
         under the eyebrow: two horizontal lines that close read as a box. */
    }
    <p class="font-mono text-small uppercase tracking-eyebrow text-muted-foreground">Sobre</p>

    <h1 class="mt-sm text-display font-semibold text-balance text-foreground">
      {profile.headline}
    </h1>

    <div class="mt-lg">
      <Prose>
        <p>{profile.bio}</p>
        <p>{profile.positioning}</p>
      </Prose>
    </div>

    <section class="mt-xl" aria-labelledby="stack-heading">
      <h2 id="stack-heading" class="font-mono text-small uppercase tracking-eyebrow text-muted-foreground">
        Stack
      </h2>
      <ul class="mt-md flex flex-wrap gap-sm">
        {profile.stack.map((item) => (
          <li>
            <TechBadge name={item} />
          </li>
        ))}
      </ul>
    </section>

    {
      email && (
        <div class="mt-xl">
          <Button href={`mailto:${email.value}`} variant="primary">
            Entrar em contato
          </Button>
        </div>
      )
    }
  </article>
</BaseLayout>
