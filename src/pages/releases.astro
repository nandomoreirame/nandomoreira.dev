---
import { TITLE_SEPARATOR } from '../lib/seo/meta';
import PageHeader from '../components/ui/PageHeader.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import VersionTag from '../components/history/VersionTag.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadSiteCommits } from '../lib/history/commits';
import { displayNameOf } from '../lib/content/display-name';
import { getProfile } from '../lib/content';
import { HISTORY_PATH, siteVersionTag } from '../lib/history/history';
import { RELEASES, RELEASES_LEAD, releaseDateOf } from '../lib/releases/releases';

const profile = await getProfile();
const tag = siteVersionTag(await loadSiteCommits());
---

<BaseLayout
  title={`Lançamentos${TITLE_SEPARATOR}${displayNameOf(profile)}`}
  description="O que entrou em cada lançamento desta versão do site, recurso por recurso."
>
  <article class="mb-3xl flex flex-col gap-xl">
    <PageHeader title="Lançamentos" description={RELEASES_LEAD}>
      <VersionTag slot="meta" tag={tag} link={{ href: HISTORY_PATH, label: 'Veja as versões anteriores →' }} />
    </PageHeader>

    {
      RELEASES.map((release) => (
        <section aria-labelledby={release.version} class="flex flex-col gap-lg">
          <header class="flex flex-col gap-sm border-b border-border pb-md">
            <div class="flex flex-wrap items-baseline gap-sm">
              <h2 id={release.version} class="font-mono text-h2 text-primary">{release.version}</h2>
              <span class="text-h3 text-foreground">{release.title}</span>
            </div>
            <time datetime={release.date} class="font-mono text-small text-muted-foreground">
              {releaseDateOf(release.date)}
            </time>
            <p class="max-w-[68ch] text-body text-foreground">{release.summary}</p>
          </header>

          <div class="grid gap-xl md:grid-cols-2">
            {release.groups.map((group) => (
              <section aria-labelledby={group.id}>
                <SectionHeader id={group.id} title={group.title} level={3} count={group.items.length} />
                <ul class="flex max-w-[68ch] list-disc flex-col gap-xs pl-lg text-body text-muted-foreground">
                  {group.items.map((item) => <li>{item}</li>)}
                </ul>
              </section>
            ))}
          </div>
        </section>
      ))
    }

    <p class="font-mono text-small text-muted-foreground">
      As versões anteriores do site estão em
      <a
        href={HISTORY_PATH}
        class="inline-flex min-h-6 items-center underline decoration-border-strong underline-offset-4 transition-colors hover:text-primary hover:decoration-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
      >{HISTORY_PATH}</a>.
    </p>
  </article>
</BaseLayout>
