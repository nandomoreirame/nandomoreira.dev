---
import PostPage from '../components/pages/PostPage.astro';
import type { PostEntry } from '../lib/content';
import { getAllPostEntries, getPostEntry } from '../lib/content';

export const prerender = true;

export async function getStaticPaths() {
  const entries = await getAllPostEntries();

  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

interface Props {
  entry: PostEntry;
}

const { entry } = Astro.props as Props;
// Re-check at render time so a draft never slips through a stale path list.
const live = await getPostEntry(entry.data.slug);

if (!live) {
  return Astro.redirect('/404');
}
---

<PostPage entry={live} locale="pt-BR" />
