---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import ListRow from '../components/ui/ListRow.astro';
import Prose from '../components/ui/Prose.astro';
import ReaderMode from '../components/posts/ReaderMode.astro';
import AiSummaryLink from '../components/posts/AiSummaryLink.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllPostEntries, getAllPosts, getPostEntry, getProfile } from '../lib/content';
import type { PostEntry } from '../lib/content';
import { generateArt } from '../lib/art';
import { toCompactStamp, toLongDate } from '../lib/format/date';
import { jsonLdForPost, serialiseJsonLd } from '../lib/posts/post-ld';
import { relatedPosts } from '../lib/posts/related';
import { toHashtag } from '../lib/posts/tags';
import { displayNameOf } from '../lib/content/display-name';
import { pageTitle } from '../lib/seo/meta';

export const prerender = true;

export async function getStaticPaths() {
  const entries = await getAllPostEntries();

  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

interface Props {
  entry: PostEntry;
}

const { entry } = Astro.props as Props;
// Re-check at render time so a draft never slips through a stale path list.
const live = await getPostEntry(entry.data.slug);

if (!live) {
  return Astro.redirect('/404');
}

const post = live.data;
const { Content } = await render(live);
const site = Astro.site?.origin ?? 'https://nandomoreira.dev';
const jsonLd = serialiseJsonLd(jsonLdForPost(post, site, await getProfile()));
const published = `publicado: ${toLongDate(post.date)}`;
const related = relatedPosts(post, await getAllPosts());
// Same generated drawing as the case pages, in the cover's place.
const art = !post.cover && post.art ? generateArt({ slug: post.slug, art: post.art, aspect: 'banner' }) : undefined;

const authorName = displayNameOf(await getProfile());
---

<BaseLayout title={pageTitle(post.seoTitle ?? post.title, authorName)} description={post.summary} section="/posts">
  <script type="application/ld+json" is:inline set:html={jsonLd} />

  <nav class="mt-lg" aria-label="Trilha de navegação" data-reader-hide>
    <a
      href={post.archived ? '/posts/arquivo' : '/posts'}
      class="inline-flex min-h-11 items-center gap-xs font-mono text-small text-muted-foreground transition-[color] duration-(--duration-fast) ease-out hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
    >
      <span aria-hidden="true">←</span>
      {post.archived ? 'Voltar ao arquivo' : 'Voltar aos posts'}
    </a>
  </nav>

  <article class="mt-2xl flex flex-col gap-xl" data-reader-article>
    <header class="flex flex-col gap-md">
      {
        post.draft && (
          <span class="inline-flex w-fit items-center rounded-sm bg-muted-foreground px-sm py-xs font-mono text-micro uppercase leading-none text-trim-cap text-primary-foreground">
            Rascunho
          </span>
        )
      }
      {
        post.archived && (
          <span class="inline-flex w-fit items-center rounded-sm border border-border-strong px-sm py-xs font-mono text-micro uppercase tracking-wide text-muted-foreground">
            Arquivo
          </span>
        )
      }
      <h1 class="font-serif text-h1 font-semibold text-foreground">{post.title}</h1>
      <p class="flex flex-wrap items-center gap-x-sm gap-y-xs font-mono text-small text-muted-foreground">
        <time datetime={post.date}>{published}</time>
        {
          post.markers && post.markers.length > 0 && (
            <Fragment>
              <span aria-hidden="true">|</span>
              {post.markers.map((marker) => (
                <span>{toHashtag(marker)}</span>
              ))}
            </Fragment>
          )
        }
      </p>
      <div class="flex flex-wrap items-start gap-sm">
        <ReaderMode />
        <AiSummaryLink markdownUrl={`${site}/${post.slug}.md`} />
      </div>
      {
        post.cover && (
          <figure class="m-0 mt-md overflow-hidden rounded-md border border-border" data-reader-hide>
            {/*
              The cover sits under the title, still above the fold, and is the
              LCP element. Astro defaults an Image to loading="lazy", which
              defers exactly what the page is waiting on: one post measured
              13.2s LCP because of it.
            */}
            <Image
              src={post.cover.src}
              alt={post.cover.alt}
              widths={[720, 1080]}
              sizes="(min-width: 62.5rem) 59.5rem, 100vw"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="h-auto w-full"
            />
          </figure>
        )
      }
      {
        art && (
          <div
            data-art
            data-reader-hide
            class="art-banner mt-md w-full overflow-hidden rounded-md border border-border bg-surface"
            set:html={art}
          />
        )
      }
    </header>
    <Prose>
      <Content />
    </Prose>
  </article>

  {
    related.length > 0 && (
      <section aria-labelledby="related-heading" class="mt-3xl mb-3xl" data-reader-hide>
        <h2 id="related-heading" class="font-mono text-small uppercase tracking-eyebrow text-muted-foreground">
          Posts relacionados
        </h2>
        <ul class="mt-md list-none p-0">
          {related.map((item) => (
            <li>
              <ListRow
                href={`/${item.slug}`}
                title={item.title}
                summary={item.summary}
                stamp={toCompactStamp(item.date)}
              />
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>
