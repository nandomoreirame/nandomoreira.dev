---
import SalesDetailPage from '../../../components/pages/SalesDetailPage.astro';
import { EN_PUBLISHED } from '../../../lib/i18n/live';
import { detailFor } from '../../../lib/sales/catalog';
export const prerender = false;
if (!EN_PUBLISHED) return new Response(null, {status: 404});
const slug = Astro.params.slug ?? '';
if (!detailFor(slug, 'en')) return new Response(null, { status: 404 });
---
<SalesDetailPage locale="en" slug={slug} />
