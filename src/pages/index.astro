---
import About from '../components/home/About.astro';
import CollectionSection from '../components/home/CollectionSection.astro';
import Contact from '../components/home/Contact.astro';
import AgentBrief from '../components/contact/AgentBrief.astro';
import { buildHireBrief } from '../lib/aeo/hire-brief';
import { requireSite } from '../lib/aeo/urls';
import Hero from '../components/home/Hero.astro';
import Services from '../components/home/Services.astro';
import Trajectory from '../components/home/Trajectory.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { serialiseJsonLd } from '../lib/aeo/json-ld';
import { collectionOfBlock } from '../lib/catalog/groups';
import { getAllProjects, getProfile } from '../lib/content';
import { homeMeta } from '../lib/home/meta';
import { organizationLd } from '../lib/home/organization-ld';
import { personLd } from '../lib/home/person-ld';

const [profile, allProjects] = await Promise.all([getProfile(), getAllProjects()]);

const knownSlugs = allProjects.map((project) => project.slug);

/**
 * Featured first, then by date. Applied per collection: a single merged list
 * let one grouping crowd out the other, which is what mixed four lab cases
 * with one portfolio case on the home.
 */
const rank = (projects: typeof allProjects) =>
  [...projects].sort((a, b) => {
    if (a.featured !== b.featured) return a.featured ? -1 : 1;
    return b.date.localeCompare(a.date);
  });

const portfolio = rank(
  allProjects.filter((project) => collectionOfBlock(project.block) === 'portfolio'),
);
const lab = rank(
  allProjects.filter((project) => collectionOfBlock(project.block) === 'lab'),
);

const site = Astro.site?.origin ?? 'https://nandomoreira.dev';
const jsonLd = serialiseJsonLd(personLd(profile, site));
const organizationJsonLd = serialiseJsonLd(
  organizationLd(profile, requireSite(Astro.site ?? new URL('https://nandomoreira.dev'))),
);
const meta = homeMeta(profile);
// One-line teaser: first sentence of the bio, without dumping the full page.
const aboutSummary = profile.bio.split(/(?<=\.)\s+/)[0] ?? profile.positioning;
const hireBrief = buildHireBrief({
  site: requireSite(Astro.site ?? new URL('https://nandomoreira.dev')),
  profile,
});
---

<BaseLayout title={meta.title} description={meta.description}>
  <script type="application/ld+json" is:inline set:html={jsonLd} />
  <script type="application/ld+json" is:inline set:html={organizationJsonLd} />

  <Hero
    headline={profile.headline}
    positioning={profile.positioning}
    availability={profile.availability}
  />
  <CollectionSection
    collection="portfolio"
    projects={portfolio}
    totalCount={portfolio.length}
    index={1}
  />
  <CollectionSection collection="lab" projects={lab} totalCount={lab.length} index={2} />
  <Trajectory stats={profile.trajectory} narrative={profile.positioning} />
  <Services services={profile.services} knownSlugs={knownSlugs} />
  <About summary={aboutSummary} />
  <Contact contacts={profile.contacts} />
  <AgentBrief brief={hireBrief} />
</BaseLayout>
