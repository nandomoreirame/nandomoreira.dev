---
import PageHeader from '../../components/ui/PageHeader.astro';
import CollectionListing from '../../components/catalog/CollectionListing.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllProjects } from '../../lib/content';

const projects = await getAllProjects();
---

<BaseLayout
  title="Portfólio | nandomoreira.dev"
  description="Trabalho entregue: produtos com IA e cases profissionais."
>
  <PageHeader
    eyebrow="Portfólio"
    title="Trabalho de cliente, do problema à produção"
    description="Plataformas de dados com IA, loja virtual e sites institucionais, entregues para empresas e organizações. Cada case mostra o problema, as decisões técnicas e o resultado."
  />
  <CollectionListing collection="portfolio" projects={projects} />
</BaseLayout>
