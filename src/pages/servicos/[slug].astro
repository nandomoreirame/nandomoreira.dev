---
import SalesDetailPage from '../../components/pages/SalesDetailPage.astro';
import { detailFor } from '../../lib/sales/catalog';
export const prerender = false;
const slug = Astro.params.slug ?? '';
if (!detailFor(slug, 'pt-BR')) return new Response(null, { status: 404 });
---
<SalesDetailPage slug={slug} />
