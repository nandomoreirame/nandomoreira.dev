---
import { Icon } from 'astro-icon/components';
import Button from '../components/ui/Button.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import ResumeLayout from '../layouts/ResumeLayout.astro';
import { CV_GO_PATH } from '../lib/analytics/outbound';
import { cvFileName } from '../lib/cv/download';
import { RESUME, careerYears } from '../lib/cv/resume';
import { FORM_HONEYPOT } from '../lib/hire/form';
import { TITLE_SEPARATOR } from '../lib/seo/meta';

export const prerender = false;

// Rendered per request, so the years and the file stamp are the moment of the visit.
const now = new Date();
const years = careerYears(now);
const fileName = cvFileName(now);

// The form posts to /api/cv, which answers with a redirect back here carrying
// `envio`; any of its outcomes reopens the dialog, so the visitor sees it.
const envio = Astro.url.searchParams.get('envio');
const sent = envio === 'ok';
const alert =
  envio === 'invalido'
    ? 'Algo no que você digitou não passou: confira o e-mail (e o nome ou a empresa, se estiverem muito longos), ou pule e baixe direto.'
    : envio === 'limite'
      ? 'Muitas tentativas seguidas. Espere alguns minutos, ou pule e baixe direto.'
      : undefined;
const reopened = sent || alert !== undefined;

const field =
  'min-h-11 w-full rounded-md border border-border-strong bg-background px-md py-sm text-body text-foreground transition-[border-color] duration-(--duration-fast) ease-out placeholder:text-muted-foreground hover:border-primary focus-visible:border-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary';
const labelClass = 'mb-sm block font-mono text-small uppercase tracking-wide text-muted-foreground';

const section = 'mb-xl break-inside-avoid-page';
const heading = 'mb-md border-b border-border-strong pb-xs font-mono text-caption uppercase tracking-eyebrow text-muted-foreground';
---

<ResumeLayout
  title={`Currículo${TITLE_SEPARATOR}${RESUME.name}`}
  description={`${RESUME.name}, ${RESUME.title}. +${years} anos de carreira, de dados a interface.`}
>
  <main id="main" class="mx-auto w-full max-w-container-narrow px-sm pt-sm pb-3xl sm:px-lg sm:pt-lg print:max-w-none print:p-0">
    <article class="rounded-lg border border-border bg-background p-md text-foreground sm:p-xl print:rounded-none print:border-0 print:p-0">
      <header class="mb-xl border-b border-border-strong pb-lg">
        <h1 class="font-serif text-h1 font-normal tracking-tight text-balance sm:text-display">{RESUME.name}</h1>
        <p class="mt-xs text-h3 text-primary">{RESUME.title}</p>
        <p class="mt-sm text-small text-muted-foreground">+{years} anos de carreira, de dados a interface</p>
        <ul class="mt-md flex flex-wrap gap-x-lg gap-y-xs text-small">
          <li>{RESUME.place}</li>
          {
            RESUME.links.map(link => (
              <li>
                <a href={link.href} class="underline underline-offset-4 hover:text-primary">{link.label}</a>
              </li>
            ))
          }
        </ul>
      </header>

      <section class={section} aria-labelledby="stack">
        <h2 id="stack" class={heading}>Stack técnica</h2>
        <dl class="grid gap-sm text-small sm:grid-cols-[9rem_1fr]">
          {
            RESUME.stack.map(row => (
              <>
                <dt class="font-semibold">{row.area}</dt>
                <dd class="text-muted-foreground sm:mb-0">{row.items}</dd>
              </>
            ))
          }
        </dl>
      </section>

      <section class="mb-xl" aria-labelledby="experiencia">
        <h2 id="experiencia" class={heading}>Experiência profissional</h2>
        <div class="flex flex-col gap-lg">
          {
            RESUME.experience.map(job => (
              <article class="break-inside-avoid-page">
                <h3 class="font-serif text-h3 font-medium">{job.company}</h3>
                <p class="text-small text-muted-foreground">
                  <span class="font-semibold text-foreground">{job.role}</span> | {job.period} | {job.place}
                </p>
                {job.intro && <p class="mt-sm text-small">{job.intro}</p>}
                <ul class="mt-sm flex list-disc flex-col gap-xs pl-lg text-small marker:text-muted-foreground">
                  {job.highlights.map(item => <li>{item}</li>)}
                </ul>
              </article>
            ))
          }
        </div>
      </section>

      <section class={section} aria-labelledby="anterior">
        <h2 id="anterior" class={heading}>Experiência anterior</h2>
        <ul class="flex flex-col gap-md text-small">
          {
            RESUME.earlier.map(item => (
              <li>
                <p>
                  <span class="font-semibold">{item.role}</span> | <span class="text-muted-foreground">{item.where}</span>
                </p>
                <p class="mt-xs">{item.summary}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section class={section} aria-labelledby="projetos">
        <h2 id="projetos" class={heading}>Projetos e open source</h2>
        <ul class="flex list-disc flex-col gap-xs pl-lg text-small marker:text-muted-foreground">
          {
            RESUME.projects.map(project => (
              <li>
                <span class="font-semibold">{project.name}</span>: {project.text}
              </li>
            ))
          }
        </ul>
      </section>

      <section aria-labelledby="formacao">
        <h2 id="formacao" class={heading}>Formação e idiomas</h2>
        <ul class="flex flex-col gap-xs text-small">
          {
            RESUME.education.map(item => (
              <li>
                <span class="font-semibold">{item.title}</span> | {item.where} | {item.period}
              </li>
            ))
          }
          <li><span class="font-semibold">Idiomas</span> | {RESUME.languages}</li>
        </ul>
      </section>
    </article>
  </main>

  {/* Fixed to the viewport, so it stays in reach however far the page has
      scrolled; print drops it. */}
  <div
    data-download-bar
    class="fixed inset-x-0 bottom-0 z-10 border-t border-border-strong bg-background px-md py-sm print:hidden"
  >
    <div class="mx-auto flex w-full max-w-container-narrow items-center justify-between gap-md">
      <p class="hidden text-small text-muted-foreground sm:block">Prefere levar o currículo? Baixe a versão em PDF.</p>
      {/* Invoker commands: the button opens the dialog natively, so the page
          still ships no script. */}
      <button
        type="button"
        command="show-modal"
        commandfor="cv-dialog"
        class="inline-flex min-h-11 min-w-11 cursor-pointer items-center justify-center gap-sm rounded-md bg-primary px-lg py-sm text-body font-medium text-primary-foreground transition-[opacity] duration-(--duration-fast) ease-out hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-foreground max-sm:w-full"
      >
        <Icon name="lucide:download" aria-hidden="true" class="size-4 shrink-0" />
        Baixar currículo (PDF)
      </button>
    </div>
  </div>

  <dialog
    id="cv-dialog"
    open={reopened}
    aria-labelledby="cv-dialog-title"
    class="fixed inset-0 z-20 m-0 size-full max-h-none max-w-none overflow-y-auto bg-foreground/60 p-md text-foreground backdrop:bg-foreground/60 open:flex open:items-center open:justify-center print:hidden"
  >
    <div class="relative w-full max-w-[48ch] rounded-lg border border-border-strong bg-background p-lg">
      <form method="dialog" class="absolute top-sm right-sm">
        <button
          type="submit"
          aria-label="Fechar"
          class="inline-flex size-11 cursor-pointer items-center justify-center rounded-md text-muted-foreground hover:bg-surface-elevated hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
          <Icon name="lucide:x" aria-hidden="true" class="size-5" />
          <span class="sr-only">Fechar</span>
        </button>
      </form>

      {
        sent ? (
          <EmptyState
            id="baixar"
            role="status"
            icon="lucide:file-check"
            title="Pronto, é só baixar"
            description="Obrigado. O que você deixou chegou até mim."
          >
            <Button href={CV_GO_PATH} download={fileName}>
              Baixar currículo (PDF)
            </Button>
          </EmptyState>
        ) : (
          <div class="flex flex-col gap-lg">
            <header class="pr-lg">
              <h2 id="cv-dialog-title" class="font-serif text-h2 font-normal tracking-tight text-balance">Antes de baixar</h2>
              <p class="mt-sm text-body text-pretty text-muted-foreground">
                Se quiser, deixe seu nome, empresa e e-mail. É só para eu saber quem está baixando meu currículo e poder retornar o contato, caso faça sentido. Todos são opcionais: dá para pular e baixar direto.
              </p>
            </header>

            {alert && (
              <p id="email-alerta" role="alert" class="rounded-md border border-primary px-md py-sm text-body">
                {alert}
              </p>
            )}

            {/* Posts natively, no JavaScript. */}
            <form action="/api/cv" method="post" class="flex flex-col gap-lg">
              <div>
                <label for="cv-nome" class={labelClass}>Nome</label>
                <input
                  id="cv-nome"
                  name="nome"
                  type="text"
                  autofocus
                  autocomplete="name"
                  maxlength="200"
                  aria-describedby={alert ? 'email-alerta' : undefined}
                  class={field}
                />
              </div>

              <div>
                <label for="cv-empresa" class={labelClass}>Empresa</label>
                <input
                  id="cv-empresa"
                  name="empresa"
                  type="text"
                  autocomplete="organization"
                  maxlength="200"
                  aria-describedby={alert ? 'email-alerta' : undefined}
                  class={field}
                />
              </div>

              <div>
                <label for="cv-email" class={labelClass}>E-mail</label>
                <input
                  id="cv-email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  inputmode="email"
                  maxlength="254"
                  placeholder="voce@empresa.com"
                  aria-describedby={alert ? 'email-alerta' : undefined}
                  class={field}
                />
              </div>

              {/* Honeypot, the same as /contato: display:none, so people, screen
                  readers and password managers skip it, while bots still fill it. */}
              <div hidden aria-hidden="true">
                <label for="cv-hp">Não preencha este campo</label>
                <input id="cv-hp" name={FORM_HONEYPOT} type="text" tabindex="-1" autocomplete="off" maxlength="200" />
              </div>

              <div class="flex flex-wrap items-center gap-md">
                <Button type="submit">Enviar e baixar</Button>
                <Button href={CV_GO_PATH} variant="ghost" download={fileName}>
                  Pular e baixar
                </Button>
              </div>
            </form>

            <p class="text-small text-muted-foreground">
              O que você deixar fica guardado por 12 meses e não vai para nenhuma lista. Os detalhes estão na <a
                href="/privacidade#curriculo"
                class="text-foreground underline underline-offset-4 hover:text-primary">política de privacidade</a
              >.
            </p>
          </div>
        )
      }
    </div>
  </dialog>
</ResumeLayout>
