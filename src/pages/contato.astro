---
import Button from '../components/ui/Button.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import AgentBrief from '../components/contact/AgentBrief.astro';
import { buildHireBrief } from '../lib/aeo/hire-brief';
import { requireSite } from '../lib/aeo/urls';
import PageHeader from '../components/ui/PageHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { displayNameOf } from '../lib/content/display-name';
import { getProfile } from '../lib/content';
import { BUDGET_OPTIONS, INTEREST_OPTIONS, outcomeMessage } from '../lib/contact/form-options';
import { FORM_HONEYPOT } from '../lib/hire/form';

const profile = await getProfile();
const email = profile.contacts.find((contact) => contact.kind === 'email');

const outcome = outcomeMessage(Astro.url.searchParams.get('envio'));
// Success replaces the form; a failure keeps it, with the alert above it.
const sent = outcome?.role === 'status';

const field =
  'min-h-11 w-full rounded-md border border-border-strong bg-background px-md py-sm text-body text-foreground transition-[border-color] duration-(--duration-fast) ease-out placeholder:text-muted-foreground hover:border-primary focus-visible:border-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary';
const labelClass = 'mb-sm block font-mono text-small uppercase tracking-wide text-muted-foreground';
const hireBrief = buildHireBrief({
  site: requireSite(Astro.site ?? new URL('https://nandomoreira.dev')),
  profile,
});
---

<BaseLayout
  title={`Contato | ${displayNameOf(profile)}`}
  description="Fale comigo sobre um projeto, uma dúvida ou uma proposta."
>
  <article class="mb-3xl flex flex-col gap-xl">
    <PageHeader
      eyebrow="Contato"
      title="Vamos conversar"
      description="Conte o que você precisa. Respondo com o que dá para fazer e o que não dá."
    />

    {/* Posts natively to the same endpoint agents use, so the form works with
        no JavaScript; the handler answers a form post with a redirect back here
        carrying `envio`, read above. */}
    <section
      aria-labelledby={sent ? undefined : 'form-heading'}
      aria-label={sent ? 'Mensagem enviada' : undefined}
      class="flex flex-col gap-lg rounded-lg border border-border-strong bg-surface p-lg"
    >
      {
        sent && outcome ? (
          <EmptyState
            id="envio"
            role="status"
            icon="lucide:mail-check"
            title="Mensagem enviada"
            description={outcome.text}
          >
            <Button href="/contato" variant="secondary">
              Enviar outra mensagem
            </Button>
          </EmptyState>
        ) : (
      <>
      <div class="flex flex-col gap-xs sm:flex-row sm:items-baseline sm:justify-between">
        <h2
          id="form-heading"
          class="font-mono text-small uppercase tracking-eyebrow text-muted-foreground"
        >
          Iniciar uma conversa
        </h2>
        <p class="font-mono text-micro text-muted-foreground">
          Os campos com * são obrigatórios.
        </p>
      </div>

      {
        outcome && (
          <p
            id="envio"
            role={outcome.role}
            class={`rounded-md border px-md py-sm text-body ${outcome.role === 'status' ? 'border-success/40 text-success' : 'border-primary text-foreground'}`}
          >
            {outcome.text}
          </p>
        )
      }

      <form action="/api/hire" method="post" class="flex flex-col gap-lg">
        <div class="grid grid-cols-1 gap-lg sm:grid-cols-2">
          <div>
            <label for="contato-nome" class={labelClass}>Nome <span aria-hidden="true">*</span></label>
            <input
              id="contato-nome"
              name="nome"
              type="text"
              autocomplete="name"
              maxlength="200"
              required
              class={field}
            />
          </div>

          <div>
            <label for="contato-email" class={labelClass}>E-mail <span aria-hidden="true">*</span></label>
            <input
              id="contato-email"
              name="email"
              type="email"
              autocomplete="email"
              maxlength="320"
              required
              class={field}
            />
          </div>

          <div>
            <label for="contato-empresa" class={labelClass}>Empresa</label>
            <input
              id="contato-empresa"
              name="empresa"
              type="text"
              autocomplete="organization"
              maxlength="200"
              class={field}
            />
          </div>

          <div>
            <label for="contato-orcamento" class={labelClass}>Orçamento</label>
            <select id="contato-orcamento" name="orcamento" class={field}>
              <option value="">Prefiro não dizer agora</option>
              {BUDGET_OPTIONS.map((option) => (
                <option value={option.value}>{option.label}</option>
              ))}
            </select>
          </div>
        </div>

        <fieldset>
          <legend class={labelClass}>Tenho interesse em</legend>
          <div class="flex flex-wrap gap-sm">
            {INTEREST_OPTIONS.map((option) => (
              <div>
                <input
                  type="checkbox"
                  id={`contato-interesse-${option.value}`}
                  name="interesse"
                  value={option.value}
                  class="chip-input sr-only"
                />
                <label
                  for={`contato-interesse-${option.value}`}
                  class="chip inline-flex min-h-11 cursor-pointer items-center rounded-full border px-md font-mono text-small transition-[border-color,color,background-color] duration-(--duration-fast) ease-out hover:border-primary"
                >
                  {option.label}
                </label>
              </div>
            ))}
          </div>
        </fieldset>

        <div>
          <label for="contato-mensagem" class={labelClass}>Mensagem <span aria-hidden="true">*</span></label>
          <textarea
            id="contato-mensagem"
            name="mensagem"
            rows="6"
            maxlength="8000"
            required
            placeholder="O que você está construindo, como é o sucesso para você e para quando precisa?"
            class={field}></textarea>
        </div>

        {/* Honeypot: display:none, so people, screen readers and password
            managers skip it, while bots reading the HTML still fill it. The
            name is meaningless on purpose (see FORM_HONEYPOT). */}
        <div hidden aria-hidden="true">
          <label for="contato-hp">Não preencha este campo</label>
          <input
            id="contato-hp"
            name={FORM_HONEYPOT}
            type="text"
            tabindex="-1"
            autocomplete="off"
            maxlength="200"
          />
        </div>

        <div class="flex flex-wrap items-center gap-md">
          <Button type="submit">Enviar mensagem</Button>
          {
            email && (
              <Button href={`mailto:${email.value}`} variant="secondary">
                Prefiro e-mail
              </Button>
            )
          }
        </div>
      </form>
      </>
        )
      }
    </section>

    <AgentBrief brief={hireBrief} />
  </article>
</BaseLayout>
