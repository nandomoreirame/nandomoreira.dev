---
import { TITLE_SEPARATOR } from '../lib/seo/meta';
Astro.response.headers.set('cache-control', 'public, max-age=60, s-maxage=300');

import ClosingCta from '../components/catalog/ClosingCta.astro';
import NowGames from '../components/now/NowGames.astro';
import NowMusic from '../components/now/NowMusic.astro';
import NowSection from '../components/now/NowSection.astro';
import AvailabilityCard from '../components/ui/AvailabilityCard.astro';
import Card from '../components/ui/Card.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import TocColumns from '../components/ui/TocColumns.astro';
import PostTocToggle from '../components/posts/PostTocToggle.astro';
import TechBadge from '../components/ui/TechBadge.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllProjects, getProfile } from '../lib/content';
import { displayNameOf } from '../lib/content/display-name';
import { saoPauloDay } from '../lib/now/day';
import { linkForRepo } from '../lib/now/github';
import { endSentence } from '../lib/now/sentence';
import { loadNow } from '../lib/now/load';
import { NOW_LEAD, NOW_UPDATED_AT } from '../lib/now/now';
import { formatPolicyDate } from '../lib/privacy/policy';

const profile = await getProfile();
const cases = await getAllProjects();
const data = await loadNow();
// Mirrors the NowSection ids and titles below, in order.
const toc = [
  { depth: 2 as const, slug: 'foco', text: 'Foco' },
  { depth: 2 as const, slug: 'projetos', text: 'Projetos em andamento' },
  { depth: 2 as const, slug: 'escrevendo', text: 'Escrevendo' },
  { depth: 2 as const, slug: 'estudando', text: 'Estudando' },
  { depth: 2 as const, slug: 'ouvindo', text: 'Ouvindo' },
  { depth: 2 as const, slug: 'jogando', text: 'Jogando' },
];
const externalAttrs = { target: '_blank', rel: 'nofollow noopener noreferrer' };
---

<BaseLayout title={`Agora${TITLE_SEPARATOR}${displayNameOf(profile)}`} description={NOW_LEAD}>
  <article class="mb-3xl flex flex-col gap-xl">
    <PageHeader title="O que estou fazendo agora" description={NOW_LEAD} updatedAt={NOW_UPDATED_AT} />

    <TocColumns items={toc}>
      <NowSection id="foco" title="Foco" step={1}>
        <AvailabilityCard status={profile.availability.status} detail={data.focus.availability} />
        <ul>
          {data.focus.items.map((item) => <li>{item}</li>)}
        </ul>
        <h3>Recusando agora</h3>
        <ul>
          {data.focus.declining.map((item) => <li>{item}</li>)}
        </ul>
      </NowSection>

      <NowSection id="projetos" title="Projetos em andamento" step={2}>
          {
            data.projects.state === 'empty' ? (
              <p class="text-muted-foreground">Sem dados no momento.</p>
            ) : (
              <ul>
                {data.projects.items.map((repo) => {
                  const href = linkForRepo(repo, cases);
                  const day = saoPauloDay(new Date(repo.pushedAt));
                  const lead = repo.description ? `: ${endSentence(repo.description)} ` : '. ';
                  return (
                    <li>
                      <a href={href} {...(href.startsWith('http') ? externalAttrs : {})}>{repo.name}</a>{lead}{repo.language && <TechBadge name={repo.language} />}{repo.language ? '. ' : ''}Último push em <time datetime={day}>{formatPolicyDate(day)}</time>.
                    </li>
                  );
                })}
              </ul>
            )
          }
      </NowSection>

      <NowSection id="escrevendo" title="Escrevendo" step={3}>
          <ul>
            {
              data.writing.latest && (
                <li>
                  <a href={`/${data.writing.latest.slug}`}>{data.writing.latest.title}</a>
                </li>
              )
            }
            {data.writing.drafts.map((title) => <li>{title}</li>)}
          </ul>
      </NowSection>

      <NowSection id="estudando" title="Estudando" step={4}>
          <ul>
            {
              data.studying.map((study) => (
                <li>
                  <a href={study.url} {...externalAttrs}>{study.topic}</a>: {study.note}
                </li>
              ))
            }
          </ul>
      </NowSection>

      <NowSection id="ouvindo" title="Ouvindo" step={5} prose={false}>
        <NowMusic music={data.music} />
      </NowSection>

      <NowSection id="jogando" title="Jogando" step={6} prose={false}>
        <NowGames games={data.games} />
      </NowSection>

      <Card as="aside" class="flex flex-col gap-sm">
        <h2 class="font-mono text-small uppercase tracking-eyebrow text-foreground">O que é uma página Agora?</h2>
        <p class="text-body text-muted-foreground">
          Uma página Agora diz no que a pessoa está focada neste momento, e não tudo o que já fez. A ideia é do Derek
          Sivers, e o <a href="https://nownownow.com" target="_blank" rel="nofollow noopener noreferrer" class="text-primary underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">nownownow.com</a> reúne as que existem.
        </p>
      </Card>
    </TocColumns>

    <ClosingCta page="now" />

    <PostTocToggle />
  </article>
</BaseLayout>
