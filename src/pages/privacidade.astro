---
import { TITLE_SEPARATOR } from '../lib/seo/meta';
import Button from '../components/ui/Button.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import Prose from '../components/ui/Prose.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { displayNameOf } from '../lib/content/display-name';
import { getProfile } from '../lib/content';
import {
  POLICY_LEAD,
  POLICY_UPDATED_AT,
  paragraphRuns,
  privacySections,
} from '../lib/privacy/policy';

const profile = await getProfile();
const email = profile.contacts.find((contact) => contact.kind === 'email');
---

<BaseLayout
  title={`Política de privacidade${TITLE_SEPARATOR}${displayNameOf(profile)}`}
  description="O que este site coleta, por quanto tempo guarda e como pedir a exclusão dos seus dados."
>
  <article class="mb-3xl flex flex-col gap-xl">
    <PageHeader title="Política de privacidade" description={POLICY_LEAD} updatedAt={POLICY_UPDATED_AT} />

    <Prose>
      {
        privacySections.map((section) => (
          <section aria-labelledby={section.id}>
            <h2 id={section.id}>{section.title}</h2>
            {section.paragraphs.map((paragraph) => (
              <p>
                {paragraphRuns(paragraph, section.links).map((run) =>
                  typeof run === 'string' ? run : <a href={run.href}>{run.label}</a>,
                )}
              </p>
            ))}
          </section>
        ))
      }

      <section aria-labelledby="contato-privacidade">
        <h2 id="contato-privacidade">Contato</h2>
        <p>Para qualquer pedido sobre seus dados, escreva para mim.</p>
      </section>
    </Prose>

    {
      email && (
        <div>
          <Button href={`mailto:${email.value}`} variant="secondary">
            {email.value}
          </Button>
        </div>
      )
    }
  </article>
</BaseLayout>
