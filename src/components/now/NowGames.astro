---
import GameProgress from './GameProgress.astro';
import type { Locale } from '../../lib/i18n/locale';
import { messagesFor } from '../../lib/i18n/messages';
import type { GamesSection } from '../../lib/now/load';
import type { GameProgress as GameProgressValue } from '../../lib/now/xbox';
import { toLongDate } from '../../lib/format/date';
import { isAllowedUrl } from '../../lib/now/safe';

interface Props {
  games: GamesSection;
  locale?: Locale;
}

interface Featured {
  name: string;
  url?: string;
  platforms: string[];
  cover?: string;
  progress?: GameProgressValue;
  kind: 'playing' | 'last';
}

const { games, locale = 'pt-BR' } = Astro.props;
const t = messagesFor(locale).nowPage;
const externalAttrs = { target: '_blank', rel: 'nofollow noopener noreferrer' };
const focus = 'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary';
const cardLink = `transition-[border-color] duration-(--duration-fast) ease-out hover:border-primary ${focus}`;

/** A card links only to a store page the catalog confirmed; otherwise it is a plain card. */
const card = (url: string | undefined) =>
  url && isAllowedUrl(url, 'www.xbox.com')
    ? { Tag: 'a' as const, attrs: { href: url, ...externalAttrs }, hover: cardLink }
    : { Tag: 'div' as const, attrs: {}, hover: '' };

const localCover = (cover: string | undefined): string | undefined =>
  cover?.startsWith('/api/now/cover/') ? cover : undefined;

const view = (() => {
  if (games.state !== 'ok') return undefined;
  const { playingNow, recent } = games.items;
  const featured: Featured | undefined = playingNow
    ? {
        name: playingNow.title,
        url: playingNow.url,
        platforms: playingNow.platforms,
        cover: playingNow.cover,
        progress: playingNow.progress,
        kind: 'playing',
      }
    : recent[0]
      ? {
          name: recent[0].name,
          url: recent[0].url,
          platforms: recent[0].platforms,
          cover: recent[0].cover,
          progress: recent[0].progress,
          kind: 'last',
        }
      : undefined;
  if (!featured) return undefined;
  return {
    featured,
    rest: recent.filter((game) => game.name !== featured.name).slice(0, 4),
  };
})();

const featuredCard = card(view?.featured.url);
const FeaturedTag = featuredCard.Tag;
const featuredEyebrow = view?.featured.kind === 'playing' ? t.playingNow : t.lastPlayed;
---

{
  games.state === 'empty' ? (
    <p class="text-muted-foreground">{t.empty}</p>
  ) : games.state === 'fallback' ? (
    <ul>
      {games.items.map((game) => (
        <li>
          {game.name}
          {game.note ? `: ${game.note}` : ''}
        </li>
      ))}
    </ul>
  ) : (
    view && (
      <div class="flex flex-col gap-lg">
        <FeaturedTag
          {...featuredCard.attrs}
          class={`flex gap-lg rounded-lg border border-border-strong bg-surface p-md sm:p-lg ${featuredCard.hover}`}
        >
          {localCover(view.featured.cover) ? (
            <img
              src={localCover(view.featured.cover)}
              width="144"
              height="144"
              alt=""
              loading="lazy"
              decoding="async"
              class="size-28 shrink-0 rounded-md bg-surface-elevated object-cover sm:size-36"
            />
          ) : (
            <span class="size-28 shrink-0 rounded-md bg-surface-elevated sm:size-36" aria-hidden="true" />
          )}
          <div data-featured-details class="flex min-w-0 flex-1 flex-col gap-sm">
            <p
              class:list={[
                'font-mono text-micro uppercase tracking-eyebrow',
                view.featured.kind === 'playing' ? 'text-primary' : 'text-muted-foreground',
              ]}
            >
              {featuredEyebrow}
            </p>
            <h3 class="font-serif text-h3 font-semibold">{view.featured.name}</h3>
            {view.featured.platforms.length > 0 && (
              <ul class="flex flex-wrap gap-xs">
                {view.featured.platforms.map((platform) => (
                  <li class="rounded-sm border border-border-strong px-xs font-mono text-micro uppercase">{platform}</li>
                ))}
              </ul>
            )}
            <GameProgress progress={view.featured.progress} name={view.featured.name} size="lg" locale={locale} />
          </div>
        </FeaturedTag>
        {view.rest.length > 0 && (
          <ul class="grid grid-cols-2 gap-md sm:grid-cols-4">
            {view.rest.map((game) => {
              const { Tag, attrs, hover } = card(game.url);
              return (
              <li>
                <Tag
                  {...attrs}
                  class={`flex h-full flex-col gap-xs rounded-md border border-border-strong bg-surface p-sm ${hover}`}
                >
                  {localCover(game.cover) ? (
                    <img
                      src={localCover(game.cover)}
                      width="320"
                      height="320"
                      alt=""
                      loading="lazy"
                      decoding="async"
                      class="aspect-square w-full rounded-md bg-surface-elevated object-cover"
                    />
                  ) : (
                    <span class="aspect-square w-full rounded-md bg-surface-elevated" aria-hidden="true" />
                  )}
                  <p class="line-clamp-2 text-small">{game.name}</p>
                  <p class="font-mono text-caption text-muted-foreground">
                    <time datetime={game.lastPlayed}>{toLongDate(game.lastPlayed, locale)}</time>
                  </p>
                  <GameProgress progress={game.progress} name={game.name} size="sm" locale={locale} />
                </Tag>
              </li>
              );
            })}
          </ul>
        )}
      </div>
    )
  )
}
