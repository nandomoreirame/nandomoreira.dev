---
import { Icon } from 'astro-icon/components';
import type { NowSnapshot } from '../../lib/now/load';

interface Props {
  music: NowSnapshot['music'];
}

const { music } = Astro.props;
const externalAttrs = { target: '_blank', rel: 'nofollow noopener noreferrer' };
const focus =
  'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary';

const localCover = (cover: string | undefined): string | undefined =>
  cover?.startsWith('/api/now/cover/') ? cover : undefined;

const localPreview = (preview: string | undefined): string | undefined =>
  preview?.startsWith('/api/now/preview/') ? preview : undefined;

const artistFrame = 'size-20 rounded-full border border-border-strong bg-surface-elevated sm:size-24';

// Play on hover, focus and touch; pause lit in primary while it plays.
const previewToggle = [
  'group/preview absolute inset-0 flex items-center justify-center bg-background/40 text-foreground',
  'opacity-0 transition-opacity duration-(--duration-fast) ease-out',
  'hover:opacity-100 focus-visible:opacity-100 pointer-coarse:opacity-100',
  'aria-pressed:bg-background/60 aria-pressed:text-primary aria-pressed:opacity-100',
  focus,
].join(' ');
---

{
  music.topArtists.state === 'ok' && (
    <div class="flex flex-col gap-md">
      <p class="font-mono text-micro uppercase tracking-eyebrow text-muted-foreground">Artistas do mês</p>
      <ul class="grid grid-cols-3 gap-md sm:grid-cols-6">
        {music.topArtists.items.map((artist, index) => {
          // Two full rows of three on a phone; the rest appears from sm.
          const phone = index >= 6 ? 'max-sm:hidden' : '';
          const photo = localCover(artist.cover);
          const preview = localPreview(artist.preview);
          const portrait = photo ? (
            <img
              src={photo}
              width="96"
              height="96"
              alt=""
              loading="lazy"
              decoding="async"
              class={`${artistFrame} object-cover transition-[border-color] duration-(--duration-fast) ease-out group-hover:border-primary`}
            />
          ) : (
            <span class={`${artistFrame} flex items-center justify-center font-mono text-small text-muted-foreground`} aria-hidden="true">
              {artist.name.slice(0, 1)}
            </span>
          );
          // With a preview the photo is the play toggle and the name is the link:
          // a button cannot live inside a link.
          return preview ? (
            <li class:list={['flex flex-col items-center gap-sm', phone]}>
              <div class="group relative">
                {portrait}
                <button
                  type="button"
                  data-now-preview={preview}
                  aria-pressed="false"
                  aria-label={`Ouvir ${artist.previewTitle ?? 'uma prévia'}, de ${artist.name}`}
                  hidden
                  class:list={[previewToggle, 'rounded-full']}
                >
                  <Icon name="lucide:play" class="size-7 group-aria-pressed/preview:hidden" aria-hidden="true" />
                  <Icon name="lucide:pause" class="hidden size-7 group-aria-pressed/preview:block" aria-hidden="true" />
                </button>
              </div>
              <a
                href={artist.url}
                {...externalAttrs}
                class:list={['line-clamp-2 text-center text-small underline-offset-4 hover:text-primary hover:underline', focus]}
              >
                {artist.name}
              </a>
            </li>
          ) : (
            <li class:list={[phone]}>
              <a href={artist.url} {...externalAttrs} class:list={['group flex flex-col items-center gap-sm', focus]}>
                {portrait}
                <span class="line-clamp-2 text-center text-small">{artist.name}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  )
}

{/* Only the six artists since 2026-10-16 (author): the recent tracks left the page. */}
{music.topArtists.state !== 'ok' && <p class="text-muted-foreground">Sem dados no momento.</p>}

<script>
  // Audio preview, /now only (docs/specs/now-page, REQ-027): the one script
  // besides the site-wide pointer effect, allowed on this route by the JS gate.
  // One <audio> for the page; a button ships hidden, so without JS nothing is promised.
  const audio = new Audio();
  audio.preload = 'none';
  let current: HTMLButtonElement | undefined;
  const mark = (on: boolean) => current?.setAttribute('aria-pressed', String(on));
  audio.addEventListener('play', () => mark(true));
  audio.addEventListener('pause', () => mark(false));
  document.querySelectorAll<HTMLButtonElement>('[data-now-preview]').forEach((button) => {
    button.hidden = false;
    button.addEventListener('click', () => {
      if (current === button && !audio.paused) return audio.pause();
      if (current !== button) {
        mark(false);
        current = button;
        audio.src = button.dataset.nowPreview ?? '';
      }
      audio.play().catch(() => mark(false));
    });
  });
</script>
