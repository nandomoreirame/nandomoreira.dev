---
import { Icon } from 'astro-icon/components';
import { AI_VIEW_LABELS } from '../../lib/ai-view/labels';

interface Props {
  humanPath: string;
  mdPath: string;
}

const { humanPath, mdPath } = Astro.props;

// One base for every control in the bar: fixed height (border included), same
// font and padding, so pill, path, tabs and actions line up as one row.
// Colours on the tab labels come only from the stylesheet: a Tailwind text
// colour would win over the component layer and leave the chosen tab unreadable.
const control = 'inline-flex h-11 items-center gap-xs border px-md font-mono text-small';
const action = `${control} rounded-md border-border-strong text-foreground transition-[border-color,color,background-color] duration-(--duration-fast) ease-out hover:border-primary hover:bg-surface-elevated hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary`;
const icon = 'size-4 shrink-0';
---

{/* Replaces the human site header on AI views (docs/specs/ai-view). Sticky,
    full width, with the same translucent blur as the human header. */}
<header
  data-ai-bar
  class="sticky top-0 z-40 border-b border-border bg-background/40 backdrop-blur-lg"
>
  <div class="flex flex-wrap items-center justify-between gap-sm px-lg py-sm">
    <div class="flex flex-wrap items-center gap-sm">
      <p data-ai-control class={`${control} rounded-full border-success/40 uppercase tracking-wide text-success`}>
        <span class="inline-block size-2 shrink-0 rounded-full bg-success" aria-hidden="true"></span>
        <span>{AI_VIEW_LABELS.ready}</span>
      </p>

      <p data-ai-control class={`${control} rounded-md border-border-strong bg-surface text-foreground`}>
        {mdPath}
      </p>

      {/* Segmented control: the labels carry the borders themselves, so the
          group adds no padding and keeps the same height as everything else. */}
      <div class="inline-flex items-center">
        <input type="radio" name="ai-tab" id="ai-tab-rendered" class="ai-tab-input sr-only" checked />
        <label
          for="ai-tab-rendered"
          data-ai-control
          class={`ai-tab-label ${control} cursor-pointer rounded-l-md border-border-strong`}
        >
          {AI_VIEW_LABELS.rendered}
        </label>
        <input type="radio" name="ai-tab" id="ai-tab-source" class="ai-tab-input sr-only" />
        <label
          for="ai-tab-source"
          data-ai-control
          class={`ai-tab-label ${control} cursor-pointer rounded-r-md border-l-0 border-border-strong`}
        >
          {AI_VIEW_LABELS.source}
        </label>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-sm">
      <button
        type="button"
        data-copy="ai-source"
        data-label-copied={AI_VIEW_LABELS.copied}
        aria-live="polite"
        hidden
        data-ai-control
        class={action}
      >
        <Icon name="lucide:copy" class={icon} aria-hidden="true" />
        <span>{AI_VIEW_LABELS.copy}</span>
      </button>
      <a href={mdPath} download data-ai-control class={action}>
        <Icon name="lucide:download" class={icon} aria-hidden="true" />
        <span>{AI_VIEW_LABELS.download}</span>
      </a>
      <a href={humanPath} data-ai-control class={action}>
        <Icon name="lucide:x" class={icon} aria-hidden="true" />
        <span>{AI_VIEW_LABELS.close}</span>
      </a>
    </div>
  </div>
</header>
