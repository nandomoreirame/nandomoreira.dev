---
import { Icon } from 'astro-icon/components';
import { visibleLinks } from '../../lib/catalog/links';
import Button from '../ui/Button.astro';

interface Props {
  repoUrl?: string | null;
  liveUrl?: string | null;
  goBase?: string;
}

const links = visibleLinks(Astro.props);
const ICONS = { repo: 'simple-icons:github', live: 'lucide:arrow-up-right' } as const;
---

{
  links.length > 0 && (
    <ul class="flex flex-wrap items-center gap-md">
      {links.map((link) => (
        <li>
          <Button href={link.href} variant={link.variant} target="_blank" rel="noopener noreferrer">
            <Icon name={ICONS[link.kind]} class="size-4 shrink-0" aria-hidden="true" />
            {link.label}
          </Button>
        </li>
      ))}
    </ul>
  )
}
