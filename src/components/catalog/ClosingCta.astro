---
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
import { closingCta, type ClosingCtaPage } from '../../lib/catalog/closing-cta';
import type { Locale } from '../../lib/i18n/locale';
import { routeFor } from '../../lib/i18n/routes';
import { salesLink } from '../../lib/sales/host';

interface Props {
  page: ClosingCtaPage;
  locale?: Locale;
}

const { page, locale = 'pt-BR' } = Astro.props;
const copy = closingCta(page, locale);
const href = copy.toServices ? salesLink(Astro.url) : routeFor('/contato', locale);
---

<Card as="section" class="my-3xl flex flex-col gap-lg p-xl lg:flex-row lg:items-center lg:justify-between">
  <div class="flex flex-col gap-sm">
    <p class="font-mono text-small uppercase tracking-eyebrow text-primary">{copy.eyebrow}</p>
    <h2 class="font-serif text-h1 font-normal tracking-tight text-pretty text-foreground">{copy.title}</h2>
    <p class="max-w-[60ch] text-body text-muted-foreground">{copy.text}</p>
  </div>
  <Button href={href} variant="primary" arrow>{copy.button}</Button>
</Card>
