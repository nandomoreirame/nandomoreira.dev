---
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
import { CLOSING_CTA, type ClosingCtaPage } from '../../lib/catalog/closing-cta';

interface Props {
  page: ClosingCtaPage;
  /** A secondary button, for a page that already has its one primary CTA (/sobre). */
  quiet?: boolean;
}

const { page, quiet = false } = Astro.props;
const copy = CLOSING_CTA[page];
---

<Card as="section" class="my-3xl flex flex-col gap-lg p-xl lg:flex-row lg:items-center lg:justify-between">
  <div class="flex flex-col gap-sm">
    <p class="font-mono text-small uppercase tracking-eyebrow text-primary">{copy.eyebrow}</p>
    <h2 class="font-serif text-h1 font-normal tracking-tight text-pretty text-foreground">{copy.title}</h2>
    <p class="max-w-[60ch] text-body text-muted-foreground">{copy.text}</p>
  </div>
  <Button href="/contato" variant={quiet ? 'secondary' : 'primary'} arrow>{copy.button}</Button>
</Card>
