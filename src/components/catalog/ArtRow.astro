---
import TechBadge from '../ui/TechBadge.astro';

interface Props {
  href: string;
  title: string;
  stamp: string;
  summary: string;
  /** Markup from generateArt; decorative, hidden from assistive technology. */
  art: string;
  /** The case stack; only the first four show. */
  tags?: string[];
  /** Situation labels such as "Descontinuado" or "Confidencial". */
  status?: string[];
}

const { href, title, stamp, summary, art, tags = [], status = [] } = Astro.props;
---

{/* Art first, text after it: the drawing announces the kind of product, the
    text says which one. One link for the whole row, so there is one tab stop. */}
<a
  href={href}
  data-art
  class="group grid grid-cols-1 items-center gap-md border-b border-border py-lg transition-[border-color] duration-(--duration-fast) ease-out hover:border-border-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary sm:grid-cols-5 sm:gap-lg"
>
  <div
    class="aspect-video w-full overflow-hidden rounded-md border border-border-strong bg-background transition-[border-color] duration-(--duration-fast) ease-out group-hover:border-primary sm:col-span-2"
    set:html={art}
  />
  <span class="flex flex-col gap-sm sm:col-span-3">
    <span class="flex items-baseline justify-between gap-md">
      <span class="font-serif text-h3 text-foreground transition-colors group-hover:text-primary">
        {title}
      </span>
      <span class="font-mono text-small text-muted-foreground">{stamp}</span>
    </span>
    <span class="text-body text-muted-foreground">{summary}</span>
    {
      (tags.length > 0 || status.length > 0) && (
        <span class="flex flex-wrap items-center gap-xs">
          {tags.slice(0, 4).map((tag) => (
            <TechBadge name={tag} />
          ))}
          {status.map((label) => (
            <span class="px-sm font-mono text-micro uppercase tracking-eyebrow text-muted-foreground">
              {label}
            </span>
          ))}
        </span>
      )
    }
  </span>
</a>
