---
import { Icon } from 'astro-icon/components';
import { BLOCK_LABELS } from '../../content/blocks';
import type { Project } from '../../content/schemas/project';
import Prose from '../ui/Prose.astro';
import TechBadge from '../ui/TechBadge.astro';
import LinkList from './LinkList.astro';
import { generateArt } from '../../lib/art';
import { collectionOfBlock } from '../../lib/catalog/groups';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const evidenceIsPrivate =
  project.confidential && !project.repoUrl && !project.liveUrl;
// The flag wins over the fields: a URL left behind in the frontmatter must not
// put a dead link back on the page after the site is gone.
const isDiscontinued = project.discontinued === true;
const art = generateArt({ slug: project.slug, block: project.block, art: project.art, aspect: 'banner' });
---

<article class="mt-2xl mb-3xl flex flex-col gap-xl">
    <div
      data-art
      class="art-banner w-full overflow-hidden rounded-md border border-border bg-surface"
      set:html={art}
    />
  <header>
    <p class="font-mono text-small uppercase tracking-eyebrow text-muted-foreground">
      {BLOCK_LABELS[project.block]}
    </p>

    <div class="mt-sm flex flex-wrap items-center gap-md">
      <h1 class="font-serif text-h1 font-normal tracking-tight text-pretty text-foreground">{project.title}</h1>
      {
        isDiscontinued && (
          <span class="inline-flex items-center rounded-md border border-border-strong px-md py-sm font-mono text-small uppercase tracking-wide text-muted-foreground">
            Descontinuado
          </span>
        )
      }
    </div>

    <p class="mt-md text-body text-muted-foreground">{project.summary}</p>
  </header>

  <section>
    <h2 class="mb-md text-h2 font-semibold text-foreground">O problema</h2>
    <Prose>
      <p class="whitespace-pre-wrap">{project.problem}</p>
    </Prose>
  </section>

  <section>
    <h2 class="mb-md text-h2 font-semibold text-foreground">Decisões técnicas</h2>
    <Prose>
      <p class="whitespace-pre-wrap">{project.decisions}</p>
    </Prose>
  </section>

  <section>
    <h2 class="mb-md text-h2 font-semibold text-foreground">Resultado</h2>
    <Prose>
      <p class="whitespace-pre-wrap">{project.outcome}</p>
    </Prose>
  </section>

  {
    project.shortcuts && project.shortcuts.length > 0 && (
      <section>
        <h2 class="mb-md text-h2 font-semibold text-foreground">Atalhos</h2>
        <dl class="flex flex-col gap-sm text-body text-muted-foreground">
          {project.shortcuts.map(({ keys, action }) => (
            <div class="flex flex-wrap items-baseline gap-x-md gap-y-xs">
              <dt class="shrink-0 font-mono text-small text-foreground">
                {keys.split('+').map((key, index) => (
                  <Fragment>
                    {index > 0 && ' + '}
                    <kbd class="rounded-md border border-border-strong bg-surface px-xs">{key}</kbd>
                  </Fragment>
                ))}
              </dt>
              <dd>{action}</dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }

  {
    project.images && project.images.length > 0 && (
      <section>
        <h2 class="mb-md text-h2 font-semibold text-foreground">Imagens</h2>
        <div class="flex flex-col gap-lg">
          {/* Lightbox through the Popover API: no script, Esc and a click
              outside close it, and the hidden copy only loads when opened. */}
          {project.images.map((image, index) => {
            const id = `case-image-${index + 1}`;
            return (
              <figure class="m-0">
                <button
                  type="button"
                  popovertarget={id}
                  aria-label={`Ampliar imagem: ${image.alt}`}
                  class="block w-full cursor-zoom-in rounded-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                >
                  <img
                    src={image.src}
                    alt={image.alt}
                    width={image.width}
                    height={image.height}
                    loading="lazy"
                    decoding="async"
                    class="h-auto w-full rounded-md border border-border transition-[border-color] duration-(--duration-fast) ease-out hover:border-border-strong"
                  />
                </button>
                <div id={id} popover role="dialog" aria-label={image.alt} class="lightbox">
                  <img
                    src={image.src}
                    alt={image.alt}
                    width={image.width}
                    height={image.height}
                    loading="lazy"
                    decoding="async"
                    class="lightbox-image"
                  />
                  <button
                    type="button"
                    popovertarget={id}
                    popovertargetaction="hide"
                    aria-label="Fechar"
                    class="lightbox-close inline-flex size-11 items-center justify-center rounded-md border border-border-strong bg-background text-foreground hover:border-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                  >
                    <Icon name="lucide:x" aria-hidden="true" class="size-5" />
                  </button>
                </div>
              </figure>
            );
          })}
        </div>
      </section>
    )
  }

  {
    /* Evidence closes the case instead of opening it: the reader gets the
       links after the argument, not before. One row, links left and tags
       right, items-center so a tall button and a short badge share a
       baseline. */
  }
  <footer class="flex flex-wrap items-center justify-between gap-md">
    {
      /* A discontinued case has no live evidence to offer, so the left side is
         empty and justify-between leaves the tags alone on the right. */
      !isDiscontinued && (
        <div class="flex items-center">
          {evidenceIsPrivate ? (
            <p class="font-mono text-small text-muted-foreground">
              Trabalho sob confidencialidade: o código e a URL não são públicos.
            </p>
          ) : (
            <LinkList
              repoUrl={project.repoUrl}
              liveUrl={project.liveUrl}
              goBase={`/go/${collectionOfBlock(project.block)}/${project.slug}`}
            />
          )}
        </div>
      )
    }

    <ul class="flex flex-wrap items-center justify-end gap-sm">
      {project.tech.map((item) => (
        <li>
          <TechBadge name={item} />
        </li>
      ))}
    </ul>
  </footer>
</article>
