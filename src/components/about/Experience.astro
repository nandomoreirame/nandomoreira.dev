---
import SectionHeader from '../ui/SectionHeader.astro';
import { formatPeriod } from '../../lib/about/period';
import type { Profile } from '../../content/schemas/profile';

interface Props {
  work: NonNullable<Profile['work']>;
}

const { work } = Astro.props;
---

<section id="experiencia" class="mt-2xl" aria-labelledby="experiencia-heading">
  <SectionHeader id="experiencia-heading" title="Experiência" level={2} count={work.length} />
  <ol class="flex flex-col gap-xl">
    {
      work.map((job) => (
        <li class="grid grid-cols-1 gap-sm md:grid-cols-4 md:gap-lg">
          {/* Period leads the row, in mono, so the eye scans the timeline first. */}
          <p class="font-mono text-small text-muted-foreground">
            {formatPeriod(job.startDate, job.endDate)}
          </p>
          <div class="flex flex-col gap-sm md:col-span-3">
            <h3 class="text-h3 font-semibold text-foreground">{job.position}</h3>
            <p class="text-body text-muted-foreground">{job.name}</p>
            {job.summary && <p class="max-w-[68ch] text-body text-foreground">{job.summary}</p>}
            {job.highlights && job.highlights.length > 0 && (
              <ul class="flex max-w-[68ch] list-disc flex-col gap-xs pl-lg text-body text-muted-foreground">
                {job.highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</section>
