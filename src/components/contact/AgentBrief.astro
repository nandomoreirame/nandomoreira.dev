---
import type { Locale } from '../../lib/i18n/locale';
import { messagesFor } from '../../lib/i18n/messages';
import AgentBriefWindow from './AgentBriefWindow.astro';

interface Props {
  /** Machine text from buildHireBrief; English on purpose. */
  brief: string;
  /** `panel` is the terminal alone, for the contact page's side column. */
  variant?: 'section' | 'panel';
  locale?: Locale;
}

const { brief, variant = 'section', locale = 'pt-BR' } = Astro.props;
const t = messagesFor(locale).home.agentBrief;
---

{variant === 'panel' ? (
  <AgentBriefWindow brief={brief} locale={locale} />
) : (
  <section
    aria-labelledby="agents-heading"
    class="grid grid-cols-1 gap-xl py-2xl lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:py-3xl"
  >
    <div class="flex flex-col gap-md">
      <p class="font-mono text-small uppercase tracking-eyebrow text-muted-foreground">
        AGENTS.md
      </p>
      <h2 id="agents-heading" class="font-serif text-h1 font-normal tracking-tight text-foreground">
        {t.heading}
      </h2>
      <p class="text-body text-muted-foreground">
        {t.body}
      </p>
      <p class="text-small text-muted-foreground">
        {t.contractBefore}{' '}
        <a
          href="/AGENTS.md"
          class="text-foreground underline underline-offset-4 hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
          >/AGENTS.md</a
        >.
      </p>
    </div>

    <AgentBriefWindow brief={brief} locale={locale} />
  </section>
)}
