---
import CopyButton from '../ui/CopyButton.astro';
import TerminalWindow from '../ui/TerminalWindow.astro';
import { BRIEF_TONE_CLASS, highlightBrief } from '../../lib/aeo/brief-highlight';

interface Props {
  /** Machine text from buildHireBrief; English on purpose. */
  brief: string;
}

const { brief } = Astro.props;
const tokens = highlightBrief(brief);
---

<TerminalWindow filename="AGENTS.md">
  <CopyButton slot="actions" target="agent-brief" label="Copiar o brief AGENTS.md" />
  <pre
    class="p-md font-mono text-small whitespace-pre-wrap wrap-anywhere text-foreground"><code id="agent-brief">{tokens.map((token) => <span class={BRIEF_TONE_CLASS[token.tone]}>{token.text}</span>)}</code></pre>
</TerminalWindow>
