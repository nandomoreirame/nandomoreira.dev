---
import type { Block } from '../../content/blocks';
import type { Locale } from '../../lib/i18n/locale';
import { messagesFor } from '../../lib/i18n/messages';
import { salesLink } from '../../lib/sales/host';
import SectionHeader from '../ui/SectionHeader.astro';
import ServiceCards from '../ui/ServiceCards.astro';

interface Props {
  services: Array<{ title: string; description: string; caseSlug: string }>;
  projects: Array<{ slug: string; block: Block }>;
  locale?: Locale;
}

const { services, projects, locale = 'pt-BR' } = Astro.props;
const t = messagesFor(locale).home.services;
---

<section id="servicos" class="pt-2xl lg:pt-3xl">
  <SectionHeader
    title={t.title}
    level={2}
    index={3}
    description={t.description}
  />

  <ServiceCards services={services} projects={projects} locale={locale} />

  <p class="mt-lg text-small text-muted-foreground">
    {t.salesLead}{' '}
    <a href={salesLink(Astro.url)} class="text-primary underline underline-offset-4 hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">{t.salesLink}</a>
  </p>
</section>
