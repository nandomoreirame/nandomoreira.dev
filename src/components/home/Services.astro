---
import type { Block } from '../../content/blocks';
import { salesUrl } from '../../lib/sales/host';
import SectionHeader from '../ui/SectionHeader.astro';
import ServiceCards from '../ui/ServiceCards.astro';

interface Props {
  services: Array<{ title: string; description: string; caseSlug: string }>;
  projects: Array<{ slug: string; block: Block }>;
}

const { services, projects } = Astro.props;
---

<section id="servicos" class="pt-2xl lg:pt-3xl">
  <SectionHeader
    title="O que eu faço por você"
    level={2}
    index={3}
    description="Cada frente com um case que a comprova."
  />

  <ServiceCards services={services} projects={projects} />

  <p class="mt-lg text-small text-muted-foreground">
    Para o seu negócio: site, loja virtual ou sistema, explicados sem jargão.
    <a href={salesUrl()} class="text-primary underline underline-offset-4 hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">Ver os serviços</a>
  </p>
</section>
