---
import type { Block } from '../../content/blocks';
import SectionHeader from '../ui/SectionHeader.astro';
import ServiceCards from '../ui/ServiceCards.astro';

interface Props {
  services: Array<{ title: string; description: string; caseSlug: string }>;
  projects: Array<{ slug: string; block: Block }>;
}

const { services, projects } = Astro.props;
---

<section id="servicos" class="py-2xl lg:py-3xl">
  <SectionHeader
    title="O que eu faço por você"
    level={2}
    index={3}
    description="Cada frente com um case que a comprova."
  />

  <ServiceCards services={services} projects={projects} />
</section>
