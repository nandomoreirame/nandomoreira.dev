---
import type { Availability } from '../../lib/content';
import Button from '../ui/Button.astro';

interface Props {
  headline: string;
  positioning: string;
  availability: Availability;
}

const { headline, positioning, availability } = Astro.props;

const STATUS_LABEL: Record<Availability['status'], string> = {
  open: 'Disponível para novos projetos',
  limited: 'Disponibilidade limitada',
  closed: 'Indisponível no momento',
};

const STATUS_DOT: Record<Availability['status'], string> = {
  open: 'bg-success',
  limited: 'bg-warning',
  closed: 'bg-destructive',
};
---

<section id="inicio" class="flex flex-col gap-lg py-2xl lg:py-3xl">
  {/* The availability is also the way in for agents: it leads to /conectar,
      the page that explains how to plug this site into an MCP client. */}
  <p>
    <a
      href="/conectar"
      class="inline-flex min-h-11 items-center gap-sm rounded-full border border-border-strong px-md font-mono text-small text-muted-foreground transition-[border-color,color] duration-(--duration-fast) ease-out hover:border-primary hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
    >
      <span
        class={`inline-block size-2 shrink-0 rounded-full ${STATUS_DOT[availability.status]}`}
        aria-hidden="true"
      ></span>
      <span>{STATUS_LABEL[availability.status]}</span>
      <span aria-hidden="true">·</span>
      <span>conectar via MCP</span>
      <span aria-hidden="true">↗</span>
    </a>
  </p>

  <h1 class="font-serif text-display font-semibold text-foreground lg:text-[3.75rem]">
    {headline}
  </h1>

  <p class="max-w-[68ch] text-body text-muted-foreground">{positioning}</p>

  <div class="flex flex-wrap items-center gap-md">
    <Button href="/portfolio" variant="primary">Ver o que eu construí</Button>
    <Button href="/#contato" variant="ghost">Dizer olá</Button>
  </div>
</section>
