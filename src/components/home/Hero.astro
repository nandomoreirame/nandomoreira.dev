---
import { PALETTE_COPY } from '../../lib/search/copy';
import Button from '../ui/Button.astro';
import Portrait from '../ui/Portrait.astro';

interface Props {
  /** Display name, for the portrait's alt text. */
  name: string;
  headline: string;
  positioning: string;
}

const { name, headline, positioning } = Astro.props;
---

<section id="inicio" class="relative isolate py-2xl lg:pt-hero-top lg:pb-hero-bottom">
  <div class="flex flex-col gap-lg lg:w-2/3">
    <h1 class="font-serif text-h1 font-normal tracking-tight text-pretty text-foreground sm:text-display">
      {headline}
    </h1>

    <p class="max-w-[68ch] text-lead text-muted-foreground">{positioning}</p>

    {/* Display comes from global.css ([data-palette-hint]), not a utility:
        a utility would beat the touch-screen rule that hides the hint. */}
    <button
      type="button"
      hidden
      data-palette-trigger
      data-palette-hint
      aria-haspopup="dialog"
      aria-keyshortcuts="Control+K Meta+K"
      aria-label={`${PALETTE_COPY.trigger} (${PALETTE_COPY.hint.before} Ctrl K ${PALETTE_COPY.hint.after})`}
      class="min-h-11 w-fit items-center gap-xs text-body text-foreground transition-[color] duration-(--duration-fast) ease-out hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
    >
      {PALETTE_COPY.hint.before}
      <kbd data-palette-mod class="rounded-md border border-border-strong bg-surface px-xs font-mono text-small">Ctrl</kbd>
      <kbd class="rounded-md border border-border-strong bg-surface px-xs font-mono text-small">K</kbd>
      {PALETTE_COPY.hint.after} <span aria-hidden="true">→</span>
    </button>

    {/* Touch screens get no keyboard hint, so this takes its place. The
        wrapper carries the display rule (global.css, next to the hint's): the
        Button's own inline-flex utility would beat it. */}
    <div data-hero-about>
      <Button href="/sobre" variant="ghost" arrow>Saiba mais sobre mim</Button>
    </div>
  </div>

  <Portrait name={name} class="lg:scale-130" />
</section>
