---
import { Icon } from 'astro-icon/components';
import type { Post } from '../../content/schemas/post';
import { toShortDate } from '../../lib/format/date';
import { BLOG_COPY } from '../../lib/posts/blog-copy';
import ListRow from '../ui/ListRow.astro';
import SectionHeader from '../ui/SectionHeader.astro';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

{
  posts.length > 0 && (
    // `relative` paints this section after the hero's portrait, which is
    // positioned and runs past the hero's bottom edge; without it the
    // faded image would sit on top of this text.
    <section id="blog" class="relative mx-auto w-full max-w-list py-2xl lg:py-3xl">
      <SectionHeader
        title="Blog"
        level={2}
        description={BLOG_COPY.description}
      />

      <ul class="mt-md list-none p-0">
        {posts.map((post) => (
          <li>
            <ListRow
              href={`/${post.slug}`}
              title={post.title}
              summary={post.summary}
              stamp={toShortDate(post.date)}
            />
          </li>
        ))}
      </ul>

      <p class="mt-lg">
        <a
          href="/posts"
          class="group/more inline-flex min-h-11 items-center gap-xs font-mono text-small text-muted-foreground transition-[color] duration-(--duration-fast) ease-out hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
          Ver todos os posts
          <Icon
            name="lucide:arrow-right"
            aria-hidden="true"
            class="size-4 shrink-0 transition-transform duration-(--duration-fast) ease-out group-hover/more:translate-x-xs"
          />
        </a>
      </p>
    </section>
  )
}
