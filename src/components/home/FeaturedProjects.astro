---
import type { Project } from '../../content/schemas/project';
import { collectionOfBlock } from '../../lib/catalog/groups';
import { toCompactStamp } from '../../lib/format/date';
import ListRow from '../ui/ListRow.astro';
import SectionHeader from '../ui/SectionHeader.astro';

interface Props {
  projects: Project[];
  totalCount: number;
}

const { projects, totalCount } = Astro.props;
const shown = projects.slice(0, 5);
const hasMore = totalCount > shown.length;
---

<section id="projetos" class="py-2xl lg:py-3xl">
  <SectionHeader
    title="Trabalho selecionado"
    level={2}
    count={shown.length}
    description="Cases com o problema, a decisão técnica e o resultado."
  />

  {
    shown.length === 0 ? (
      <p class="rounded-md border border-border bg-surface p-lg text-body text-muted-foreground">
        Nenhum case em destaque ainda.
      </p>
    ) : (
      <ul class="list-none p-0">
        {shown.map((project) => {
          const dest = collectionOfBlock(project.block);
          return (
            <li>
              <ListRow
                href={`/${dest}/${project.slug}`}
                title={project.title}
                summary={project.summary}
                markers={project.tech}
                stamp={toCompactStamp(project.date)}
              />
            </li>
          );
        })}
      </ul>
    )
  }

  {
    hasMore && (
      <p class="mt-lg">
        <a
          href="/portfolio"
          class="inline-flex min-h-11 items-center text-body text-primary underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
          Ver todos ({String(totalCount).padStart(2, '0')})
        </a>
      </p>
    )
  }
</section>
