---
import { Icon } from 'astro-icon/components';
import { contactGoPath } from '../../lib/analytics/outbound';
import { contactIconFor } from '../../lib/ui/contact-icons';
import SectionHeader from '../ui/SectionHeader.astro';

interface Props {
  contacts: Array<{ kind: string; value: string }>;
}

const { contacts } = Astro.props;

if (contacts.length === 0) {
  throw new Error(
    'The home needs at least one direct contact channel: US-005 requires it.',
  );
}

const LABELS: Record<string, string> = {
  email: 'E-mail',
  github: 'GitHub',
  linkedin: 'LinkedIn',
  site: 'Site',
};
---

<section id="contato" class="py-2xl lg:py-3xl">
  {/* The direct channels stay first here: the PRD requires at least one direct
      contact with no mandatory form. /contato offers the form as an option. */}
  <SectionHeader
    title="Contato"
    level={2}
    index={5}
    description="Escreva direto, ou use o formulário em /contato."
  />

  <ul class="flex flex-wrap gap-md">
    {contacts.map((contact) => (
      <li>
        <a
          href={contactGoPath(contact.kind)}
          target={contact.kind === 'email' ? undefined : '_blank'}
          rel={contact.kind === 'email' ? undefined : 'noopener'}
          class="inline-flex min-h-11 items-center gap-xs rounded-md border border-border-strong px-md py-sm text-body text-foreground transition-[border-color,background-color] duration-(--duration-fast) ease-out hover:border-primary hover:bg-surface-elevated focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
          {contactIconFor(contact.kind) && (
            <Icon name={contactIconFor(contact.kind)!} class="size-4 shrink-0" aria-hidden="true" />
          )}
          {LABELS[contact.kind] ?? contact.kind}
        </a>
      </li>
    ))}
  </ul>
</section>
