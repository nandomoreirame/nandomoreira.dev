---
import { Icon } from 'astro-icon/components';
import TurnstileWidget from '../security/TurnstileWidget.astro';
import Card from '../ui/Card.astro';
import { FORM_HONEYPOT } from '../../lib/hire/form';
import type { Locale } from '../../lib/i18n/locale';
import { withLocale } from '../../lib/i18n/locale';
import { routeFor } from '../../lib/i18n/routes';
import type { SubscribeOutcome } from '../../lib/newsletter/handler';
import { newsletterCopy, newsletterOutcomes } from '../../lib/newsletter/copy';

interface Props {
  outcome?: SubscribeOutcome;
  /** A secondary submit, for a page that already has its one primary CTA (the home). */
  quiet?: boolean;
  /** Page the answer comes back to; /posts when absent. Localised from the locale. */
  returnTo?: '/' | '/posts' | '/setup' | '/en' | '/en/posts' | '/en/setup';
  locale?: Locale;
}

const { outcome, quiet = false, returnTo, locale = 'pt-BR' } = Astro.props;
const copy = newsletterCopy(locale);
const outcomes = newsletterOutcomes(locale);
const turnstileSiteKey = (process.env.TURNSTILE_SITE_KEY ?? '').trim();
const origin =
  returnTo !== undefined
    ? withLocale(returnTo, locale)
    : locale === 'en'
      ? '/en/posts'
      : undefined;
const action = origin ? `/api/subscribe?origem=${encodeURIComponent(origin)}` : '/api/subscribe';
const privacyHref = `${routeFor('/privacidade', locale)}#novidades`;
const submit = quiet
  ? 'border border-border-strong bg-surface text-foreground hover:border-primary hover:bg-surface-elevated'
  : 'bg-primary text-primary-foreground hover:opacity-90 hover:shadow-glow';
const result = outcome ? outcomes[outcome] : undefined;
---

<Card as="section" id="novidades" class="flex flex-col gap-lg lg:flex-row lg:items-center lg:justify-between" aria-labelledby="novidades-titulo">
  <div class="flex flex-col gap-xs">
    <p class="flex items-center gap-sm font-mono text-small uppercase tracking-wide text-primary">
      <Icon name="lucide:mail" aria-hidden="true" class="size-4 shrink-0" />
      {copy.eyebrow}
    </p>
    <h2 id="novidades-titulo" class="text-h3 font-medium text-foreground">{copy.title}</h2>
    <p class="text-body text-muted-foreground">{copy.text}</p>
    <p class="text-small text-muted-foreground">
      {copy.consent}{' '}
      <a href={privacyHref} class="text-primary underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">{copy.privacyLink}</a>.
    </p>
    {result && <p role={result.role} class="text-small text-foreground">{result.text}</p>}
  </div>

  <form action={action} method="post" class="flex w-full flex-col gap-sm lg:w-auto">
    <div class="flex w-full flex-col gap-sm sm:flex-row">
    <label for="novidades-email" class="sr-only">{copy.emailLabel}</label>
    <input
      id="novidades-email"
      name="email"
      type="email"
      autocomplete="email"
      maxlength="320"
      required
      placeholder={copy.placeholder}
      class="min-h-11 w-full rounded-md border border-border-strong bg-background px-md font-mono text-small text-foreground placeholder:text-muted-foreground focus-visible:border-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary sm:w-72"
    />
    <input type="text" name={FORM_HONEYPOT} tabindex="-1" autocomplete="off" aria-hidden="true" class="sr-only" />
    <button
      type="submit"
      class={`inline-flex min-h-11 items-center justify-center rounded-md px-md text-body font-medium transition-[opacity,box-shadow,border-color,background-color] duration-(--duration-fast) ease-out focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary ${submit}`}
    >
      {copy.button}
    </button>
    </div>
    <TurnstileWidget siteKey={turnstileSiteKey} />
  </form>
</Card>
