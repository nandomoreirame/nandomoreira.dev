---
import type { Locale } from '../../lib/i18n/locale';
import { messagesFor } from '../../lib/i18n/messages';
import { listingHref } from '../../lib/posts/listing-view';

interface Props {
  page: number;
  totalPages: number;
  first: number;
  last: number;
  total: number;
  locale?: Locale;
  base?: string;
}

const { page, totalPages, first, last, total, locale = 'pt-BR', base = '/posts' } = Astro.props;
const t = messagesFor(locale).posts;
// Page 1 is the listing itself, never ?pagina=1: one URL per page.
// The grid or list choice is a cookie, so the links do not carry it.
const hrefOf = (target: number) => listingHref(target, base);
const prev = page > 1 ? hrefOf(page - 1) : undefined;
const next = page < totalPages ? hrefOf(page + 1) : undefined;
const range = t.articleRange(first, last);

const step =
  'inline-flex min-h-11 items-center rounded-sm border px-md font-mono text-small transition-[border-color,color] duration-(--duration-fast) ease-out';
const active = `${step} border-border-strong bg-surface text-foreground hover:border-primary hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary`;
const inactive = `${step} border-border text-muted-foreground opacity-60`;
---

{/* Older and newer pages of the current posts, as in the Stitch listing:
    the steps on the left, where the reader is on the right. */}
<nav
  aria-label={t.pagination}
  data-pagination
  class="mt-2xl flex flex-wrap items-center justify-between gap-md border-t border-border pt-xl"
>
  <div class="flex flex-wrap gap-sm">
    {
      prev ? (
        <a href={prev} rel="prev" class={active}>
          {t.newer}
        </a>
      ) : (
        <span aria-disabled="true" class={inactive}>
          {t.newer}
        </span>
      )
    }
    {
      next ? (
        <a href={next} rel="next" class={active}>
          {t.older}
        </a>
      ) : (
        <span aria-disabled="true" class={inactive}>
          {t.older}
        </span>
      )
    }
  </div>
  <p class="font-mono text-small text-muted-foreground">
    {t.pageWord} <span class="text-primary">{page}</span> {t.pageRest(totalPages, range, total)}
  </p>
</nav>
