---
import AboutProfile from '../sales/AboutProfile.astro';
---

{/* The post's closing card: who wrote it, the landing's about card (asked on
    2026-10-19). */}
<aside
  data-author-box
  data-reader-hide
  aria-labelledby="author-about-title"
  class="mt-2xl rounded-lg border border-border bg-surface p-lg"
>
  <AboutProfile eyebrow="O autor" headingId="author-about-title" aboutHref="/sobre" compact
    points={false}
    role="Sou desenvolvedor de software sênior em São Paulo. Escrevo aqui sobre meus estudos e experimentos pra mim mesmo; se você está lendo, é um bônus :)"
  />
</aside>
