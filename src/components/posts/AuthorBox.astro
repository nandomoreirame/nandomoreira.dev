---
import AboutProfile from '../sales/AboutProfile.astro';
import type { Locale } from '../../lib/i18n/locale';
import { messagesFor } from '../../lib/i18n/messages';
import { routeFor } from '../../lib/i18n/routes';

interface Props {
  locale?: Locale;
}

const { locale = 'pt-BR' } = Astro.props;
const t = messagesFor(locale).posts;
---

{/* The post's closing card: who wrote it, the landing's about card (asked on
    2026-10-19). */}
<aside
  data-author-box
  data-reader-hide
  aria-labelledby="author-about-title"
  class="mt-2xl rounded-lg border border-border bg-surface p-lg"
>
  <AboutProfile
    eyebrow={t.authorEyebrow}
    headingId="author-about-title"
    aboutHref={routeFor('/sobre', locale)}
    ctaLabel={t.authorCta}
    compact
    points={false}
    role={t.authorRole}
  />
</aside>
