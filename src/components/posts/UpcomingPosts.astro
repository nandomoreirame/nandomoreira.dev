---
import { Icon } from 'astro-icon/components';
import { UPCOMING_LIMIT } from './upcoming-limit';

interface Props {
  /** The drafts in progress, newest first. */
  posts: { title: string; slug: string }[];
  /** Link each title to its page; true only where draft pages exist (dev, staging). */
  linked?: boolean;
  /** List every draft instead of the newest few; true where the author reviews them (dev, staging). */
  all?: boolean;
}

const { linked = false, all = false } = Astro.props;
const posts = all ? Astro.props.posts : Astro.props.posts.slice(0, UPCOMING_LIMIT);
---

{/* Names what is coming. Draft pages exist only in dev and staging, so the
    titles link there and stay plain text in production. */}
{
  posts.length > 0 && (
    <section
      aria-labelledby="upcoming-heading"
      class="mt-2xl rounded-md border border-border-strong bg-surface p-lg"
    >
      <h2 id="upcoming-heading" class="flex items-center gap-sm font-mono text-small uppercase tracking-eyebrow text-primary">
        <Icon name="lucide:file" aria-hidden="true" class="size-4 shrink-0" />
        Rascunhos em andamento
      </h2>
      <ul class="mt-sm list-disc pl-lg text-body text-foreground marker:text-muted-foreground">
        {posts.map((post) => (
          <li class="mt-xs">
            {linked ? (
              <a
                href={`/${post.slug}`}
                class="text-foreground underline decoration-border-strong underline-offset-4 transition-[color] duration-(--duration-fast) ease-out hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
              >{post.title}</a>
            ) : (
              post.title
            )}
          </li>
        ))}
      </ul>
    </section>
  )
}
