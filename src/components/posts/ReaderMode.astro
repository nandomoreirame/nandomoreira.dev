---
import { Icon } from 'astro-icon/components';
import { READER_SETTINGS, READER_SWITCH_ID, readerInputId } from '../../lib/posts/reader';

// Off, this is one switch under the post title. On, the stylesheet pins it to
// the top corner with the settings beside it (global.css, "Reading mode").
const control =
  'inline-flex min-h-11 cursor-pointer items-center gap-xs rounded-md border border-border-strong bg-surface px-md font-mono text-small text-muted-foreground transition-[color,border-color] duration-(--duration-fast) ease-out hover:border-primary hover:text-foreground has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-primary';
const chip =
  'inline-flex min-h-11 flex-1 cursor-pointer items-center justify-center rounded-md border border-border-strong px-sm font-mono text-small text-muted-foreground transition-[color,border-color] duration-(--duration-fast) ease-out hover:text-foreground has-checked:border-primary has-checked:text-foreground has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-primary';
const step =
  'inline-flex size-11 shrink-0 cursor-pointer items-center justify-center rounded-md border border-border-strong font-mono text-body text-foreground transition-[border-color] duration-(--duration-fast) ease-out hover:border-primary';
---

<div data-reader class="reader flex flex-wrap items-start gap-sm">
  <label class={control}>
    <input type="checkbox" role="switch" id={READER_SWITCH_ID} class="sr-only" />
    <Icon name="lucide:book-open" class="reader-icon-enter size-4 shrink-0" aria-hidden="true" />
    <Icon name="lucide:x" class="reader-icon-leave size-4 shrink-0" aria-hidden="true" />
    <span>Modo leitura</span>
  </label>

  <details class="reader-settings relative">
    <summary class={`${control} list-none`}>
      <Icon name="lucide:a-large-small" class="size-4 shrink-0" aria-hidden="true" />
      <span class="sr-only">Ajustes de leitura</span>
    </summary>
    <div
      class="reader-panel absolute top-full right-0 z-10 mt-sm flex w-72 flex-col gap-md rounded-md border border-border-strong bg-surface-elevated p-md"
    >
      {
        READER_SETTINGS.map((setting) => (
          <fieldset class="m-0 flex flex-col gap-xs border-0 p-0">
            <legend class="mb-xs font-mono text-micro uppercase tracking-eyebrow text-muted-foreground">
              {setting.legend}
            </legend>
            {setting.kind === 'chips' ? (
              <div class="flex gap-xs">
                {setting.choices.map((choice) => (
                  <label class={chip}>
                    <input
                      type="radio"
                      name={`reader-${setting.name}`}
                      id={readerInputId(setting.name, choice.value)}
                      value={choice.value}
                      checked={choice.value === setting.initial}
                      class="sr-only"
                    />
                    {choice.label}
                  </label>
                ))}
              </div>
            ) : (
              <div class="reader-stepper">
                {/* Each radio is followed by its own − value + row, and only
                    the checked one shows (global.css). − and + are labels of
                    the neighbouring radios; the keyboard steps with the arrows. */}
                {setting.choices.map((choice, index) => {
                  const prev = setting.choices[index - 1];
                  const next = setting.choices[index + 1];
                  return (
                    <Fragment>
                      <input
                        type="radio"
                        name={`reader-${setting.name}`}
                        id={readerInputId(setting.name, choice.value)}
                        value={choice.value}
                        checked={choice.value === setting.initial}
                        aria-label={`${setting.legend}: ${choice.label}`}
                        class="sr-only"
                      />
                      <div data-step class="reader-step items-center gap-xs rounded-md">
                        {prev ? (
                          <label for={readerInputId(setting.name, prev.value)} aria-hidden="true" class={step}>
                            −
                          </label>
                        ) : (
                          <span aria-hidden="true" class={`${step} opacity-40`}>
                            −
                          </span>
                        )}
                        <span
                          aria-hidden="true"
                          data-value={setting.name}
                          class="flex-1 text-center font-mono text-small text-foreground"
                        >
                          {setting.name === 'leading' ? '' : choice.label}
                        </span>
                        {next ? (
                          <label for={readerInputId(setting.name, next.value)} aria-hidden="true" class={step}>
                            +
                          </label>
                        ) : (
                          <span aria-hidden="true" class={`${step} opacity-40`}>
                            +
                          </span>
                        )}
                      </div>
                    </Fragment>
                  );
                })}
              </div>
            )}
          </fieldset>
        ))
      }
    </div>
  </details>
</div>
