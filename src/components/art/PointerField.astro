---
/**
 * The only client script the site ships (docs/specs/generative-case-art,
 * REQ-012), on every page since 2026-10-08. It writes CSS variables and nothing else: the dot grid,
 * the parallax and the portrait tilt are CSS. Removing this component removes the effect and
 * nothing more (REQ-017). Without JavaScript, on touch, or with reduced motion,
 * the art simply stays still (REQ-008).
 */
---

{/* Renders no wrapper: the layout marks <body> as the field, so the header and
    footer rules still reach the viewport edges. */}

<script>
  // Copy buttons (AI view, AGENTS.md brief). Lives in this, the site's only
  // script, so the JS gate keeps accepting one script. A button names its
  // source by id in data-copy, ships hidden and appears only here, so without
  // JS it never promises an action.
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
    const source = document.getElementById(button.dataset.copy ?? '');
    if (!source || !navigator.clipboard) return;
    // Only the text changes, so the icon beside it survives the confirmation.
    const text = button.querySelector('span') ?? button;
    const label = text.textContent;
    button.hidden = false;
    button.addEventListener('click', async () => {
      await navigator.clipboard.writeText(source.textContent ?? '');
      text.textContent = button.dataset.labelCopied ?? label;
      button.toggleAttribute('data-copied', true);
      setTimeout(() => {
        text.textContent = label;
        button.removeAttribute('data-copied');
      }, 2000);
    });
  });

  // Header fill on scroll: bare at the top, filled once the page moves.
  const header = document.querySelector('[data-site-header]');
  if (header) {
    const sync = () => header.toggleAttribute('data-scrolled', window.scrollY > 8);
    // No read at load: it forced a synchronous layout (Lighthouse). Opening
    // mid-page (anchor, restored position) fires scroll, which syncs it.
    window.addEventListener('scroll', sync, { passive: true });
  }

  // Reading mode (posts): the switch and the radios already work through CSS.
  // This only remembers the choices and leaves the mode on Escape. Storage can
  // throw (private window, blocked site data), and the mode works without it.
  const reader = document.getElementById('reader-on') as HTMLInputElement | null;
  if (reader) {
    document.querySelectorAll<HTMLInputElement>('[data-reader] input[type=radio]').forEach((input) => {
      try {
        if (localStorage.getItem(input.name) === input.value) input.checked = true;
      } catch {}
      input.addEventListener('change', () => {
        try {
          localStorage.setItem(input.name, input.value);
        } catch {}
      });
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && reader.checked) {
        reader.checked = false;
        reader.focus();
      }
    });
  }

  // Post index. Below 768px a jump closes the popover, so it does not cover the
  // section it just opened (from md it is never open, and this is a no-op).
  const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc] a')];
  tocLinks.forEach((link) => {
    link.addEventListener('click', () => {
      const toc = link.closest<HTMLElement>('[popover]');
      if (toc?.matches(':popover-open')) toc.hidePopover();
    });
  });

  // The section being read gets aria-current, styled like the main menu's
  // current page: the last heading that has passed under the sticky header
  // (96px, the root scroll padding, plus a little). Recomputed on scroll, once
  // per frame, so a jump, an anchor or a restored position all land right.
  const sections = tocLinks.flatMap((link) => {
    const heading = document.getElementById(decodeURIComponent(link.hash.slice(1)));
    return heading ? [{ link, heading }] : [];
  });
  if (sections.length) {
    let pending = 0;
    const markCurrent = () => {
      pending = 0;
      const index = sections.findLastIndex(({ heading }) => heading.getBoundingClientRect().top <= 120);
      sections.forEach(({ link }, at) =>
        at === index ? link.setAttribute('aria-current', 'true') : link.removeAttribute('aria-current'),
      );
    };
    window.addEventListener('scroll', () => (pending ||= requestAnimationFrame(markCurrent)), { passive: true });
  }

  const fine = window.matchMedia('(pointer: fine)').matches;
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (fine && !calm) {
    // The portrait (home, /sobre) turns toward the pointer: its position
    // relative to the portrait's own box, centred on 0 and clamped to ±0.5 so
    // the turn stays small when the mouse is far away.
    const tilts = document.querySelectorAll<HTMLElement>('[data-tilt]');
    const clamp = (value: number) => Math.max(-0.5, Math.min(0.5, value)).toFixed(3);

    document.querySelectorAll<HTMLElement>('[data-pointer-field]').forEach((field) => {
      let last: PointerEvent | null = null;
      let frame = 0;
      let snap = true;
      let current: HTMLElement | null = null;

      const release = () => {
        current?.style.removeProperty('--mx');
        current?.style.removeProperty('--my');
        current = null;
      };

      const paint = () => {
        frame = 0;
        if (!last) return;
        if (snap) {
          field.dataset.snap = '';
          snap = false;
          requestAnimationFrame(() => {
            delete field.dataset.snap;
          });
        }
        // Viewport coordinates: the grid layer is position: fixed.
        field.style.setProperty('--gx', `${last.clientX}px`);
        field.style.setProperty('--gy', `${last.clientY}px`);

        tilts.forEach((tilt) => {
          const box = tilt.getBoundingClientRect();
          tilt.style.setProperty('--tx', clamp((last!.clientX - box.left) / box.width - 0.5));
          tilt.style.setProperty('--ty', clamp((last!.clientY - box.top) / box.height - 0.5));
        });

        const art = (last.target as Element | null)?.closest<HTMLElement>('[data-art]') ?? null;
        if (art !== current) release();
        if (art) {
          const rect = art.getBoundingClientRect();
          art.style.setProperty('--mx', ((last.clientX - rect.left) / rect.width).toFixed(3));
          art.style.setProperty('--my', ((last.clientY - rect.top) / rect.height).toFixed(3));
          current = art;
        }
      };

      field.addEventListener('pointermove', (event) => {
        last = event;
        field.dataset.active = '';
        if (!frame) frame = requestAnimationFrame(paint);
      });

      field.addEventListener('pointerleave', () => {
        last = null;
        snap = true;
        delete field.dataset.active;
        delete field.dataset.snap;
        release();
        tilts.forEach((tilt) => {
          tilt.style.removeProperty('--tx');
          tilt.style.removeProperty('--ty');
        });
      });
    });
  }
</script>
