---
import { SHORT_WORDMARK, splitWordmark } from '../../lib/layout/wordmark';

interface Props {
  name: string;
  /** Part of the brand painted in the primary colour. */
  accent?: string;
  /** Home of the current locale; defaults to the pt-BR root. */
  href?: string;
}

const { name, accent, href = '/' } = Astro.props;
const brand = splitWordmark(name, accent);
---

<a
  href={href}
  class="inline-flex shrink-0 items-center gap-xs font-mono sm:gap-sm text-small font-medium text-foreground transition-[color] duration-(--duration-fast) ease-out hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
>
  <img src="/brand-mark.png" alt="" width="40" height="40" class="size-8 shrink-0 sm:size-10" />
  {/* One line on purpose: any whitespace between the parts would split the
      brand into words, on screen and for screen readers. The outer span keeps
      the parts as one flex item beside the mark. */}
  {/* Below md the header is short on room: the brand shrinks to ndm.dev. */}
  <span class="md:hidden">{SHORT_WORDMARK.before}<span class="text-primary">{SHORT_WORDMARK.accent}</span>{SHORT_WORDMARK.after}</span>
  <span class="max-md:hidden">{brand.before}{brand.accent && <span class="text-primary">{brand.accent}</span>}{brand.after}</span>
</a>
