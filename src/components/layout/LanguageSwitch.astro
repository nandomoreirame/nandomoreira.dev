---
import { messagesFor } from '../../lib/i18n/messages';
import { EN_PUBLISHED } from '../../lib/i18n/live';
import type { Locale } from '../../lib/i18n/locale';
import type { TranslationPair } from '../../lib/content';

interface Props {
  locale: Locale;
  alternates?: TranslationPair;
  /** Tests override; the build reads EN_PUBLISHED. */
  live?: boolean;
  /** Layout utilities from the place that puts it. */
  class?: string;
  /**
   * Visible text in the page's own language ("Versão em inglês"), replacing
   * the EN/PT code. It is then the link's name, so no aria-label or lang.
   */
  text?: string;
}

const { locale, alternates, live = EN_PUBLISHED, class: extra, text } = Astro.props;
const target: Locale = locale === 'en' ? 'pt-BR' : 'en';
// Without a pair, the other language's home (REQ-017).
const href = alternates?.[target] ?? (target === 'en' ? '/en' : '/');
// Labelled in the destination language: it is read by whoever wants that language.
const label = messagesFor(target).language.switchTo;
const short = target === 'en' ? 'EN' : 'PT';
---

{
  (live || alternates) && (
    <a
      href={href}
      hreflang={target}
      lang={text ? undefined : target}
      aria-label={text ? undefined : label}
      data-language-switch
      class={`inline-flex min-h-11 items-center font-mono text-micro uppercase tracking-wide text-muted-foreground transition-[color] duration-(--duration-fast) ease-out hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary ${extra ?? ''}`.trim()}
    >
      <span class="text-trim-cap">{text ?? short}</span>
    </a>
  )
}
