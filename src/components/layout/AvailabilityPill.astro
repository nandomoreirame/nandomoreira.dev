---
import type { HTMLAttributes } from 'astro/types';
import type { Availability } from '../../lib/content';
import { AVAILABILITY_LABEL, AVAILABILITY_SHORT } from '../../lib/layout/availability';
import StatusDot from '../ui/StatusDot.astro';

interface Props extends HTMLAttributes<'a'> {
  status: Availability['status'];
}

// `slot` only places the pill in a parent; it must not reach the link.
const { status, class: extra, slot: _slot, ...rest } = Astro.props;
const focus = 'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary';
---

{/* The header pill, also in the open mobile menu. One word on phones and
    tablets (the menu fills the row up to lg), the full label from lg; the
    accessible name is always the full label. */}
<a
  href="/mcp"
  aria-label={AVAILABILITY_LABEL[status]}
  class={`inline-flex min-h-8 shrink-0 items-center gap-sm rounded-full border border-border bg-surface px-md font-mono text-caption text-foreground transition-[border-color] duration-(--duration-fast) ease-out hover:border-border-strong ${focus} ${extra ?? ''}`}
  {...rest}
>
  <StatusDot status={status} />
  <span class="lg:hidden">{AVAILABILITY_SHORT[status]}</span>
  <span class="hidden lg:inline">{AVAILABILITY_LABEL[status]}</span>
  <span aria-hidden="true" class="hidden lg:inline">↗</span>
</a>
