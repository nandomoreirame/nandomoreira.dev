---
import type { HTMLAttributes } from 'astro/types';
import type { Availability } from '../../lib/content';
import type { Locale } from '../../lib/i18n/locale';
import { availabilityLabel, availabilityShort } from '../../lib/layout/availability';
import { routeFor } from '../../lib/i18n/routes';
import StatusDot from '../ui/StatusDot.astro';

interface Props extends HTMLAttributes<'a'> {
  status: Availability['status'];
  locale?: Locale;
}

// `slot` only places the pill in a parent; it must not reach the link.
const { status, locale = 'pt-BR', class: extra, slot: _slot, ...rest } = Astro.props;
const label = availabilityLabel(status, locale);
const short = availabilityShort(status, locale);
const href = routeFor('/contato', locale);
const focus = 'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary';
---

{/* The header pill, also in the open mobile menu. One word on phones and
    tablets (the menu fills the row up to lg), the full label from lg; the
    accessible name is always the full label. */}
<a
  href={href}
  aria-label={label}
  class={`inline-flex min-h-8 shrink-0 items-center gap-xs rounded-full border border-border bg-surface px-3 font-mono sm:gap-sm sm:px-md text-caption text-foreground transition-[border-color] duration-(--duration-fast) ease-out hover:border-border-strong ${focus} ${extra ?? ''}`}
  {...rest}
>
  <StatusDot status={status} />
  <span class="lg:hidden">{short}</span>
  <span class="hidden lg:inline">{label}</span>
  <span aria-hidden="true" class="hidden lg:inline">→</span>
</a>
