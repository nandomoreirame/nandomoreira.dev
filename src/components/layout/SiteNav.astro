---
interface Props {
  current?: string;
  hasPosts?: boolean;
}

const { current, hasPosts = false } = Astro.props;

const items = [
  { href: '/portfolio', label: 'Portfólio' },
  { href: '/lab', label: 'Lab' },
  ...(hasPosts ? [{ href: '/posts', label: 'Posts' }] : []),
  { href: '/sobre', label: 'Sobre' },
  { href: '/mcp', label: 'MCP' },
  { href: '/contato', label: 'Contato' },
];
---

<nav aria-label="Navegação principal" class="w-full md:w-auto">
  <ul class="flex flex-wrap items-center justify-center gap-x-md gap-y-0 md:justify-end md:gap-lg">
    {items.map((item) => (
      <li class="flex">
        <a
          href={item.href}
          aria-current={current === item.href ? 'page' : undefined}
          class="inline-flex min-h-11 items-center font-mono text-micro uppercase tracking-wide text-muted-foreground transition-[color] duration-(--duration-fast) ease-out hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary aria-[current=page]:text-primary"
        >
          <span class="text-trim-cap">{item.label}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>
