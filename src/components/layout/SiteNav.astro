---
import { Icon } from 'astro-icon/components';
import { messagesFor } from '../../lib/i18n/messages';
import type { Locale } from '../../lib/i18n/locale';
import { routeFor } from '../../lib/i18n/routes';
import { navCurrent } from '../../lib/layout/nav-current';

interface Props {
  current?: string;
  /** Menu item a page belongs to when its path does not say so (a post). */
  section?: string;
  hasPosts?: boolean;
  locale?: Locale;
}

const { current, section, hasPosts = false, locale = 'pt-BR' } = Astro.props;

const t = messagesFor(locale).nav;
const items = [
  { href: routeFor('/sobre', locale), label: t.about },
  { href: routeFor('/now', locale), label: t.now },
  { href: routeFor('/setup', locale), label: t.setup },
  ...(hasPosts ? [{ href: routeFor('/posts', locale), label: t.blog }] : []),
  { href: routeFor('/portfolio', locale), label: t.portfolio },
  { href: routeFor('/lab', locale), label: t.lab },
  { href: routeFor('/mcp', locale), label: t.mcp },
  { href: routeFor('/contato', locale), label: t.contact },
];

const linkFocus =
  'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary';
// Both buttons exist only below md, where the bar is tight: 32px wide keeps the
// row on one line at 320px; the 44px height keeps the touch target tall.
const iconButton =
  `inline-flex h-11 w-8 items-center justify-center text-foreground transition-[color] duration-(--duration-fast) ease-out hover:text-primary ${linkFocus}`;
---

<div class="flex items-center justify-end max-md:order-last md:flex-1 md:justify-start">
  <button
    type="button"
    popovertarget="site-menu"
    aria-label={t.openMenu}
    class={`md:hidden ${iconButton}`}
  >
    <Icon name="lucide:menu" aria-hidden="true" class="size-6" />
  </button>

  <nav aria-label={t.mainNavigation} class="hidden w-full md:block md:w-auto">
    <ul class="hidden items-center gap-xs md:flex lg:gap-sm">
      {items.map((item, index) => (
        <li class="flex items-center gap-xs lg:gap-sm">
          {/* Decorative separator; screen readers already hear a list. */}
          {index > 0 && <span aria-hidden="true" class="font-mono text-micro text-muted-foreground">•</span>}
          <a
            href={item.href}
            aria-current={navCurrent(item.href, { current, section })}
            class={`nav-underline inline-flex min-h-11 items-center font-mono text-micro uppercase tracking-wide text-muted-foreground transition-[color] duration-(--duration-fast) ease-out hover:text-foreground ${linkFocus} aria-[current=page]:text-primary aria-[current=true]:text-primary`}
          >
            <span class="text-trim-cap">{item.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div id="site-menu" popover role="dialog" aria-label={t.menu} class="site-menu">
    {/* Tight and wrapping: a narrow screen squeezes the row, never hides a control. */}
    <div class="mx-auto flex w-full max-w-frame flex-wrap items-center justify-between gap-xs px-md py-sm">
      <slot name="wordmark" />
      <slot name="availability" />
      <slot name="theme" />
      <button
        type="button"
        popovertarget="site-menu"
        popovertargetaction="hide"
        aria-label={t.closeMenu}
        class={`site-menu-close shrink-0 ${iconButton}`}
      >
        <Icon name="lucide:x" aria-hidden="true" class="size-6" />
      </button>
    </div>

    <nav
      aria-label={t.mobileNavigation}
      class="flex flex-1 flex-col items-center px-lg pb-lg"
    >
      <ul class="flex w-full max-w-page flex-1 flex-col">
        {items.map((item) => (
          <li class="flex flex-1 border-b border-border first:border-t">
            <a
              href={item.href}
              aria-current={navCurrent(item.href, { current, section })}
              class={`flex min-h-16 w-full items-center justify-center font-serif text-h1 text-foreground transition-[color] duration-(--duration-fast) ease-out hover:text-primary ${linkFocus} aria-[current=page]:text-primary aria-[current=true]:text-primary`}
            >
              <span class="text-trim-cap">{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</div>
