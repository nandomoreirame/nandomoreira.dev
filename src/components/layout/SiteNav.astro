---
import { Icon } from 'astro-icon/components';
import { navCurrent } from '../../lib/layout/nav-current';

interface Props {
  current?: string;
  /** Menu item a page belongs to when its path does not say so (a post). */
  section?: string;
  hasPosts?: boolean;
}

const { current, section, hasPosts = false } = Astro.props;

const items = [
  ...(hasPosts ? [{ href: '/posts', label: 'Blog' }] : []),
  { href: '/portfolio', label: 'Portfólio' },
  { href: '/lab', label: 'Lab' },
  { href: '/setup', label: 'Setup' },
  { href: '/now', label: 'Agora' },
  { href: '/sobre', label: 'Sobre' },
  { href: '/mcp', label: 'MCP' },
  { href: '/contato', label: 'Contato' },
];

const linkFocus =
  'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary';
const iconButton =
  `inline-flex size-11 items-center justify-center text-foreground transition-[color] duration-(--duration-fast) ease-out hover:text-primary ${linkFocus}`;
---

<div class="flex flex-1 items-center justify-end md:justify-start">
  <button
    type="button"
    popovertarget="site-menu"
    aria-label="Abrir menu"
    class={`md:hidden ${iconButton}`}
  >
    <Icon name="lucide:menu" aria-hidden="true" class="size-6" />
  </button>

  <nav aria-label="Navegação principal" class="hidden w-full md:block md:w-auto">
    <ul class="hidden items-center gap-lg md:flex">
      {items.map((item) => (
        <li class="flex">
          <a
            href={item.href}
            aria-current={navCurrent(item.href, { current, section })}
            class={`nav-underline inline-flex min-h-11 items-center font-mono text-micro uppercase tracking-wide text-muted-foreground transition-[color] duration-(--duration-fast) ease-out hover:text-foreground ${linkFocus} aria-[current=page]:text-primary aria-[current=true]:text-primary`}
          >
            <span class="text-trim-cap">{item.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div id="site-menu" popover role="dialog" aria-label="Menu" class="site-menu">
    <div class="mx-auto flex w-full max-w-frame items-center justify-between px-lg py-sm">
      <slot name="wordmark" />
      <button
        type="button"
        popovertarget="site-menu"
        popovertargetaction="hide"
        aria-label="Fechar menu"
        class={`site-menu-close ${iconButton}`}
      >
        <Icon name="lucide:x" aria-hidden="true" class="size-6" />
      </button>
    </div>

    <nav
      aria-label="Menu principal (mobile)"
      class="flex flex-1 flex-col items-center px-lg pb-lg"
    >
      <ul class="flex w-full max-w-page flex-1 flex-col">
        {items.map((item) => (
          <li class="flex flex-1 border-b border-border first:border-t">
            <a
              href={item.href}
              aria-current={navCurrent(item.href, { current, section })}
              class={`flex min-h-16 w-full items-center justify-center font-serif text-h1 text-foreground transition-[color] duration-(--duration-fast) ease-out hover:text-primary ${linkFocus} aria-[current=page]:text-primary aria-[current=true]:text-primary`}
            >
              <span class="text-trim-cap">{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</div>
