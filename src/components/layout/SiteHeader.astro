---
import SiteNav from './SiteNav.astro';
import Wordmark from './Wordmark.astro';
import type { Availability } from '../../lib/content';
import AvailabilityPill from './AvailabilityPill.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  name: string;
  /** Part of the brand painted in the primary colour. */
  accent?: string;
  current?: string;
  section?: string;
  hasPosts?: boolean;
  /** Tones the brand dot, and shows as a pill on the right edge: one word below lg, the full label from it. */
  availability?: Availability;
}

const {
  name,
  accent,
  current,
  section,
  hasPosts = false,
  availability,
} = Astro.props;

---

{/* The rule sits on <header> so it spans the viewport; the container is the row
    inside it, which keeps the content on the frame. Sticky is pure CSS and
    depends on no ancestor being a scroll container (see the overflow-x-clip
    note in global.css). The hairline is always on; the site script sets
    data-scrolled once the page moves, which fills the bar behind a blur. */}
<header
  data-site-header
  class="sticky top-0 z-40 border-b border-border transition-[background-color] duration-(--duration-base) ease-out data-scrolled:bg-background/40 data-scrolled:backdrop-blur-lg"
>
  <div class="mx-auto flex w-full max-w-frame items-center justify-between gap-md px-lg py-sm xl:gap-xl">
    <Wordmark name={name} accent={accent} status={availability?.status} />

    <SiteNav current={current} section={section} hasPosts={hasPosts}>
      <Wordmark slot="wordmark" name={name} accent={accent} status={availability?.status} />
      {availability && <AvailabilityPill slot="availability" status={availability.status} data-menu-availability class="ml-auto" />}
      <ThemeToggle slot="theme" />
    </SiteNav>

    {availability && <AvailabilityPill status={availability.status} data-header-availability class="max-md:ml-auto" />}
    {/* From md only: below it the wordmark, the pill and the menu button fill a
        390px bar, so the switch moves into the menu (slot="theme" above). */}
    <ThemeToggle class="max-md:hidden" />
  </div>
</header>
