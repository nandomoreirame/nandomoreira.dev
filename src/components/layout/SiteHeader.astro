---
import SiteNav from './SiteNav.astro';
import Wordmark from './Wordmark.astro';
import type { Availability } from '../../lib/content';
import StatusDot from '../ui/StatusDot.astro';
import { AVAILABILITY_LABEL } from '../../lib/layout/availability';

interface Props {
  name: string;
  /** Part of the brand painted in the primary colour. */
  accent?: string;
  current?: string;
  section?: string;
  hasPosts?: boolean;
  /** Tones the brand dot, and shows as a pill on the right edge where the row has room. */
  availability?: Availability;
}

const {
  name,
  accent,
  current,
  section,
  hasPosts = false,
  availability,
} = Astro.props;

const focus = 'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary';
---

{/* The rule sits on <header> so it spans the viewport; the container is the row
    inside it, which keeps the content on the frame. Sticky is pure CSS and
    depends on no ancestor being a scroll container (see the overflow-x-clip
    note in global.css). The hairline is always on; the site script sets
    data-scrolled once the page moves, which fills the bar behind a blur. */}
<header
  data-site-header
  class="sticky top-0 z-40 border-b border-border transition-[background-color] duration-(--duration-base) ease-out data-scrolled:bg-background/40 data-scrolled:backdrop-blur-lg"
>
  <div class="mx-auto flex w-full max-w-frame items-center justify-between gap-xl px-lg py-sm">
    <Wordmark name={name} accent={accent} status={availability?.status} />

    <SiteNav current={current} section={section} hasPosts={hasPosts}>
      <Wordmark slot="wordmark" name={name} accent={accent} status={availability?.status} />
    </SiteNav>

    {
      availability && (
        <a
          href="/mcp"
          data-header-availability
          class={`hidden min-h-8 shrink-0 items-center gap-sm rounded-full border border-border bg-surface px-md font-mono text-caption text-foreground transition-[border-color] duration-(--duration-fast) ease-out hover:border-border-strong xl:inline-flex ${focus}`}
        >
          <StatusDot status={availability.status} />
          <span>{AVAILABILITY_LABEL[availability.status]}</span>
          <span aria-hidden="true">↗</span>
        </a>
      )
    }
  </div>
</header>
