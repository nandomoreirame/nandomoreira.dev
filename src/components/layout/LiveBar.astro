---
import { DEFAULT_LIVE_BAR } from '../../lib/live-bar/config';
import { liveBarHtml } from '../../lib/live-bar/render';
---

{/* Announcement strip above the header. It scrolls away with the page, so the
    sticky header stays the only fixed bar. The track holds the items twice
    and slides one copy to the left in a loop (global.css); the copy is hidden
    from screen readers and the tab order. With reduced motion it stops and
    shows the first copy only. The rule sits on the wrapper to span the viewport.
    The markup is the default items; the script below swaps the track for the
    ones in Firestore (site_config/live_bar), built by the same function. */}
<div data-live-bar data-live-bar-sync data-reader-hide class="overflow-hidden border-b border-border bg-surface">
  <div class="live-bar-track flex w-max" set:html={liveBarHtml(DEFAULT_LIVE_BAR.items)} />
</div>

<script>
  // Announcement items from Firestore through /api/live-bar, so they change
  // without a deploy, also on prerendered pages. Without JS or on a failed
  // fetch the default items stay.
  const bar = document.querySelector<HTMLElement>('[data-live-bar-sync]');
  bar &&
    fetch('/api/live-bar')
      .then((response) => response.json())
      .then(({ enabled, html }) => {
        if (!enabled) return void (bar.hidden = true);
        bar.firstElementChild!.innerHTML = html;
      })
      .catch(() => {});
</script>
