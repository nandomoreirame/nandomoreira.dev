---
import { Icon } from 'astro-icon/components';
import type { Locale } from '../../lib/i18n/locale';
import { themeCopy } from '../../lib/theme/copy';

interface Props {
  /** Layout utilities from the header that places it. */
  class?: string;
  /** 32px wide instead of 44, for the tight mobile menu row; still 44px tall. */
  compact?: boolean;
  locale?: Locale;
}

const { class: extra, locale = 'pt-BR', compact = false } = Astro.props;
const copy = themeCopy(locale);
---

{/* The theme boot script owns the click (src/lib/theme/boot.ts) and global.css
    hides the button until that script ran, so without JS it never promises an
    action. Each state names the theme it switches to; CSS shows only the
    current one, and display:none also drops the other name from the tree. */}
<button
  type="button"
  data-theme-toggle
  class={`inline-flex ${compact ? 'h-11 w-8' : 'size-11'} shrink-0 items-center justify-center text-foreground transition-[color] duration-(--duration-fast) ease-out hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary ${extra ?? ''}`}
>
  <span data-theme-when="noir" class="contents">
    <Icon name="lucide:sun" aria-hidden="true" class="size-5" />
    <span class="sr-only">{copy.toPaper}</span>
  </span>
  <span data-theme-when="paper" class="contents">
    <Icon name="lucide:moon" aria-hidden="true" class="size-5" />
    <span class="sr-only">{copy.toNoir}</span>
  </span>
</button>
