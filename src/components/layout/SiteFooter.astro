---
import { contactGoPath } from '../../lib/analytics/outbound';
import { HISTORY_PATH } from '../../lib/history/history';

interface Props {
  name: string;
  year: number;
  contacts: Array<{ kind: string; value: string }>;
  /** Version tag, v<versions>.<commits> (BaseLayout reads the commits). */
  version: string;
}

const { name, year, contacts, version } = Astro.props;

const LABELS: Record<string, string> = {
  github: 'GitHub',
  linkedin: 'LinkedIn',
  site: 'Site',
};

// Email is deliberately absent: the footer is on every page and gets scraped.
const social = contacts.filter((contact) => contact.kind in LABELS);

const link =
  'inline-flex min-h-11 items-center transition-colors hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary';
---

{/* Same split as the header: rule on <footer>, frame on the row inside. */}
<footer class="mt-3xl border-t border-border" data-reader-hide>
  <div
    class="mx-auto flex w-full max-w-frame flex-col gap-md px-lg py-xl font-mono text-caption tracking-wide text-muted-foreground sm:flex-row sm:items-center sm:justify-between"
  >
    <p class="flex flex-wrap items-center gap-x-sm">
      <span>© {year} {name}.</span>
      <span aria-hidden="true">·</span>
      <a href="/privacidade" class={link}>Privacidade</a>
      <span aria-hidden="true">·</span>
      {/* The easter egg: the tag counts every version this site had (/version). */}
      <a href={HISTORY_PATH} class={link} aria-label={`Versão ${version.slice(1)}: a história do site`}>
        {version}
      </a>
    </p>

    <nav class="flex flex-wrap items-center gap-x-lg" aria-label="Canais">
      {social.map((contact) => (
        <a href={contactGoPath(contact.kind)} target="_blank" rel="noopener" class={link}>
          {LABELS[contact.kind]}
        </a>
      ))}
      <a href="/rss.xml" class={link}>RSS</a>
      <a href="/AGENTS.md" class={link}>AGENTS.md</a>
      <a href="#main" class={link}>Topo ↑</a>
    </nav>
  </div>
</footer>
