---
import { Icon } from 'astro-icon/components';
import { contactGoPath } from '../../lib/analytics/outbound';
import type { Locale } from '../../lib/i18n/locale';
import { messagesFor } from '../../lib/i18n/messages';
import { routeFor } from '../../lib/i18n/routes';
import { contactIconFor } from '../../lib/ui/contact-icons';
import { RELEASES_PATH } from '../../lib/releases/releases';

interface Props {
  name: string;
  year: number;
  contacts: Array<{ kind: string; value: string }>;
  /** Version tag, v<versions>.<commits> (BaseLayout reads the commits). */
  version: string;
  locale?: Locale;
}

const { name, year, contacts, version, locale = 'pt-BR' } = Astro.props;
const t = messagesFor(locale).footer;
const rssHref = locale === 'en' ? '/en/rss.xml' : '/rss.xml';
const privacyHref = routeFor('/privacidade', locale);

const LABELS: Record<string, string> = {
  github: 'GitHub',
  linkedin: 'LinkedIn',
  site: 'Site',
  youtube: 'YouTube',
  twitch: 'Twitch',
  instagram: 'Instagram',
  x: 'X',
  devnull: '/dev/null',
};

// Email is deliberately absent: the footer is on every page and gets scraped.
const social = contacts.filter((contact) => contact.kind in LABELS);

const socialLink =
  'group/social relative inline-flex size-9 items-center justify-center transition-colors hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary';

const link =
  'inline-flex min-h-11 items-center transition-colors hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary';
---

{/* Same split as the header: rule on <footer>, frame on the row inside. */}
<footer class="mt-3xl border-t border-border" data-reader-hide>
  <div
    class="mx-auto flex w-full max-w-frame flex-col gap-md px-lg py-xl font-mono text-caption tracking-wide text-muted-foreground sm:flex-row sm:items-center sm:justify-between"
  >
    <p class="flex flex-wrap items-center gap-x-sm">
      <span>© {year} {name}.</span>
      <span aria-hidden="true">·</span>
      <a href={privacyHref} class={link}>{t.privacy}</a>
      <span aria-hidden="true">·</span>
      {/* The easter egg: the tag counts every version this site had (/releases/17). */}
      <a href={RELEASES_PATH} class={link} aria-label={t.versionLabel(version.slice(1))}>
        {version}
      </a>
    </p>

    <nav class="flex flex-wrap items-center gap-x-lg" aria-label={t.channels}>
      <a href={locale === 'en' ? 'https://links.nandomoreira.dev/en/' : 'https://links.nandomoreira.dev'} target="_blank" rel="noopener" class={link}>{t.links}</a>
      <a href={rssHref} class={link}>{t.rss}</a>
      <a href="/AGENTS.md" class={link}>{t.agents}</a>
      <span class="flex items-center">
        {social.map((contact) => (
          <a
            href={contactGoPath(contact.kind)}
            target="_blank"
            rel="noopener"
            aria-label={t.opensInNewTab(LABELS[contact.kind]!)}
            class={socialLink}
          >
            <Icon name={contactIconFor(contact.kind)!} class="size-4" aria-hidden="true" />
            {/* The name as a tooltip, above the icon: the footer is the last thing on the page. */}
            <span
              aria-hidden="true"
              class="pointer-events-none absolute bottom-full left-1/2 z-10 mb-xs -translate-x-1/2 whitespace-nowrap rounded-md border border-border-strong bg-surface-elevated px-sm py-xs font-mono text-caption text-foreground opacity-0 transition-opacity duration-(--duration-fast) ease-out group-hover/social:opacity-100 group-focus-visible/social:opacity-100"
            >
              {LABELS[contact.kind]}
            </span>
          </a>
        ))}
      </span>
    </nav>
  </div>
</footer>
