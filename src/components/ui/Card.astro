---
/**
 * Layer 1 of the Terminal Noir elevation: a raised surface bounded by the
 * hairline, never a drop shadow. An interactive card lifts its border to the
 * strong token on hover; the hairline alone never delimits a target.
 */
interface Props {
  as?: 'div' | 'li' | 'article' | 'section' | 'aside';
  interactive?: boolean;
  class?: string;
  id?: string;
  'aria-labelledby'?: string;
  'aria-label'?: string;
}

const {
  as: Tag = 'div',
  interactive = false,
  class: extra,
  id,
  'aria-labelledby': ariaLabelledby,
  'aria-label': ariaLabel,
} = Astro.props;

const classes = [
  'rounded-md border border-border bg-surface p-lg',
  interactive
    ? 'transition-[border-color] duration-(--duration-fast) ease-out hover:border-border-strong'
    : '',
  extra ?? '',
]
  .filter(Boolean)
  .join(' ');
---

<Tag id={id} class={classes} aria-labelledby={ariaLabelledby} aria-label={ariaLabel}><slot /></Tag>
