---
import { Icon } from 'astro-icon/components';

interface Props {
  href: string;
  title: string;
  summary?: string;
  markers?: string[];
  /** Status chip rendered before the markers, e.g. a draft. */
  badge?: string;
  stamp?: string;
}

const { href, title, summary, markers = [], badge, stamp } = Astro.props;

// The leading column only exists when there is something to put in it: an
// empty fixed column would leave a hole in the notes listing (REQ-022).
// Below sm the stamp sits on its own row above the title, so a long title gets
// the full width of a phone instead of wrapping into a narrow column.
// A full date (posts, "16 out. 2026") needs a wider column than MM/YYYY (cases).
const columns = stamp
  ? `grid-cols-[1fr_auto] ${stamp.length > 7 ? 'sm:grid-cols-[7rem_1fr_auto]' : 'sm:grid-cols-[4.5rem_1fr_auto]'} gap-x-md gap-y-xs sm:gap-y-md`
  : 'grid-cols-[1fr_auto] gap-md';
const contentPlacement = stamp ? 'col-start-1 row-start-2 sm:col-start-2 sm:row-start-1' : '';
const arrowPlacement = stamp ? 'col-start-2 row-start-2 sm:col-start-3 sm:row-start-1' : '';
const shownMarkers = markers.slice(0, 3);
---

<a
  href={href}
  class={`group grid ${columns} items-baseline border-b border-border py-lg transition-[border-color,color] duration-(--duration-fast) ease-out hover:border-border-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary`}
>
  {stamp && <span data-stamp class="col-start-1 row-start-1 font-mono text-small text-muted-foreground">{stamp}</span>}

  <span data-content class={`min-w-0 ${contentPlacement}`}>
    {/* The title wraps rather than truncating: cut at ~30 characters it read as nothing on a phone. */}
    <span
      data-title
      class="block font-serif text-h3 text-pretty text-foreground transition-colors group-hover:text-primary"
    >
      {title}
    </span>
    {summary && (
      <span data-summary class="mt-xs hidden sm:line-clamp-2 text-small text-muted-foreground">
        {summary}
      </span>
    )}
    {(badge || shownMarkers.length > 0) && (
      <span data-markers class="mt-xs flex flex-wrap items-center gap-xs font-mono text-micro text-muted-foreground">
        {
          badge && (
            <span class="mr-sm inline-flex items-center rounded-sm bg-muted-foreground px-sm py-xs font-mono uppercase leading-none text-trim-cap text-primary-foreground">
              {badge}
            </span>
          )
        }
        {
          shownMarkers.map((marker, index) => (
            <>
              {index > 0 && <span aria-hidden="true">·</span>}
              <span
                data-marker
                class="inline-flex items-center rounded-sm border border-border bg-surface px-sm py-xs font-mono text-micro leading-none text-muted-foreground"
              >
                {marker}
              </span>
            </>
          ))
        }
      </span>
    )}
  </span>

  <span
    aria-hidden="true"
    class={`${arrowPlacement} text-muted-foreground transition-transform group-hover:translate-x-xs group-hover:text-primary`}
  >
    <Icon name="lucide:arrow-right" aria-hidden="true" class="size-4 shrink-0" />
  </span>
</a>
