---
import { Icon } from 'astro-icon/components';
import Card from './Card.astro';
import type { Block } from '../../content/blocks';
import type { Locale } from '../../lib/i18n/locale';
import { withLocale } from '../../lib/i18n/locale';
import { messagesFor } from '../../lib/i18n/messages';
import { assertServicesHaveCases, serviceCaseHref } from '../../lib/home/services';

interface Props {
  services: Array<{ title: string; description: string; caseSlug: string }>;
  projects: Array<{ slug: string; block: Block }>;
  locale?: Locale;
}

const { services, projects, locale = 'pt-BR' } = Astro.props;
const proofLink = messagesFor(locale).home.services.proofLink;

// Glyphs from the Stitch home, keyed by the proving case. A service without a
// mapping stays text-only rather than wearing a glyph that does not match it.
const SERVICE_ICONS: Record<string, string> = {
  bragstack: 'lucide:layers',
  'financial-normalization': 'lucide:workflow',
  'amnesia-claude-code': 'lucide:terminal',
};

assertServicesHaveCases(
  services,
  projects.map((project) => project.slug),
);
---

<ul class="grid grid-cols-1 gap-lg lg:grid-cols-3">
  {
    services.map((service) => {
      const caseHref = serviceCaseHref(service.caseSlug, projects);
      const href = caseHref ? withLocale(caseHref, locale) : null;
      const icon = SERVICE_ICONS[service.caseSlug];
      return (
        <Card as="li" interactive class="flex flex-col gap-sm">
          {icon && (
            <span class="inline-flex size-8 items-center justify-center rounded-sm border border-border bg-surface-elevated text-primary">
              <Icon name={icon} aria-hidden="true" class="size-5" />
            </span>
          )}
          <h3 class="text-h3 font-semibold text-foreground">{service.title}</h3>
          <p class="text-body text-muted-foreground">{service.description}</p>
          {href && (
            <a
              href={href}
              class="group/proof mt-auto inline-flex min-h-11 items-center gap-xs border-t border-border pt-md font-mono text-small text-primary transition-[color] duration-(--duration-fast) ease-out hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            >
              {proofLink}
              <Icon
                name="lucide:arrow-right"
                aria-hidden="true"
                class="size-4 shrink-0 transition-transform duration-(--duration-fast) ease-out group-hover/proof:translate-x-xs"
              />
            </a>
          )}
        </Card>
      );
    })
  }
</ul>
