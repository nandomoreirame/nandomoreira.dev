---
import { Icon } from 'astro-icon/components';
import Card from './Card.astro';
import type { Block } from '../../content/blocks';
import { assertServicesHaveCases, serviceCaseHref } from '../../lib/home/services';

interface Props {
  services: Array<{ title: string; description: string; caseSlug: string }>;
  projects: Array<{ slug: string; block: Block }>;
}

const { services, projects } = Astro.props;

assertServicesHaveCases(
  services,
  projects.map((project) => project.slug),
);
---

<ul class="grid grid-cols-1 gap-lg lg:grid-cols-3">
  {
    services.map((service) => {
      const href = serviceCaseHref(service.caseSlug, projects);
      return (
        <Card as="li" interactive class="flex flex-col gap-sm">
          <h3 class="text-h3 font-semibold text-foreground">{service.title}</h3>
          <p class="text-body text-muted-foreground">{service.description}</p>
          {href && (
            <a
              href={href}
              class="group/proof mt-auto inline-flex min-h-11 items-center gap-xs border-t border-border pt-md font-mono text-small text-primary transition-[color] duration-(--duration-fast) ease-out hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            >
              Ver o case que comprova
              <Icon
                name="lucide:arrow-right"
                aria-hidden="true"
                class="size-4 shrink-0 transition-transform duration-(--duration-fast) ease-out group-hover/proof:translate-x-xs"
              />
            </a>
          )}
        </Card>
      );
    })
  }
</ul>
