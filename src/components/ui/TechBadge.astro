---
import { Icon } from 'astro-icon/components';
import { techIconFor } from '../../lib/ui/tech-icons';

interface Props {
  name: string;
}

const { name } = Astro.props;
const icon = techIconFor(name);
---

<span
  class="inline-flex max-w-full items-center gap-xs rounded-sm border border-border bg-surface px-sm py-xs font-mono text-caption break-words text-muted-foreground transition-[border-color,color] duration-(--duration-fast) ease-out hover:border-primary hover:text-foreground"
>
  {icon && <Icon name={icon} class="size-3.5 shrink-0" aria-hidden="true" />}
  {name}
</span>
