---
import PostToc from '../posts/PostToc.astro';
import type { TocItem } from '../../lib/posts/toc';

interface Props {
  /** The page sections, linked by the ids of their headings. */
  items: TocItem[];
}

const { items } = Astro.props;
---

{/* The post index, on a page made of sections (/now, /setup): a sticky card
    left of the text from md. Below md the card is the popover that
    PostTocToggle opens, so the aside is `contents` there, never hidden: a
    popover under display:none opens but paints nothing. Pair it with a
    <PostTocToggle /> that is a direct child of the page's <article>. */}
<div data-toc-layout class="flex flex-col gap-xl md:grid md:grid-cols-[12rem_minmax(0,1fr)] md:gap-xl lg:grid-cols-[16rem_minmax(0,1fr)] lg:gap-2xl">
  <aside data-toc-aside class="contents md:sticky md:top-3xl md:flex md:flex-col md:self-start">
    <PostToc items={items} />
  </aside>
  <div class="flex min-w-0 flex-col gap-xl">
    <slot />
  </div>
</div>
