---
interface Props {
  /** Fill the container instead of the 68ch reading measure (the AI view). */
  wide?: boolean;
}

const { wide = false } = Astro.props;
const measure = wide ? 'max-w-none' : 'max-w-[68ch]';

// Rendered markdown (posts, cases, the AI view) gets its rhythm here: wide gaps
// between paragraphs, a section-opening h2 well apart from the text above and
// close to its own first paragraph (after rubenmarcus.dev, 2026-10-10).
const flow = [
  '[&_p]:mt-lg',
  '[&_a]:text-primary [&_a]:underline',
  '[&_strong]:font-semibold',
  '[&_h2]:mt-2xl [&_h2]:text-h2 sm:[&_h2]:text-h1 [&_h2]:font-semibold [&_h2]:leading-tight [&_h2]:text-balance',
  '[&_h3]:mt-xl [&_h3]:text-h3 [&_h3]:font-semibold [&_h3]:leading-snug',
  '[&_:is(h2,h3)+:is(p,ul,ol,pre,blockquote,.code-block)]:mt-sm',
  // The reset strips list styling; without it a list reads as loose lines.
  '[&_ul]:list-disc [&_ol]:list-decimal [&_:is(ul,ol)]:mt-lg [&_:is(ul,ol)]:pl-lg [&_li]:mt-xs [&_li]:marker:text-muted-foreground',
  '[&_blockquote]:mt-lg [&_blockquote]:border-l-2 [&_blockquote]:border-primary [&_blockquote]:pl-md [&_blockquote]:text-muted-foreground',
  '[&_hr]:my-2xl [&_hr]:border-border',
  '[&_table]:block [&_table]:overflow-x-auto',
];

// Code blocks come from Shiki with their own colours (measured in
// code-contrast.test.ts); this only frames and spaces them.
const code = [
  '[&_.code-block]:my-lg [&_pre]:my-0 [&_pre]:rounded-md [&_pre]:border [&_pre]:border-border-strong [&_pre]:p-md [&_pre]:pl-sm [&_pre]:font-mono [&_pre]:text-small [&_pre]:leading-normal',
  '[&_:not(pre)>code]:rounded-md [&_:not(pre)>code]:border [&_:not(pre)>code]:border-border-strong [&_:not(pre)>code]:bg-surface-elevated [&_:not(pre)>code]:px-xs [&_:not(pre)>code]:font-mono [&_:not(pre)>code]:text-small',
];
---

<div
  class={`${measure} font-serif text-body leading-relaxed text-foreground ${flow.join(' ')} ${code.join(' ')}`}
>
  <slot />
</div>
