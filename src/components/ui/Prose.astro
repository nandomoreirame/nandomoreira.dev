---
interface Props {
  /** Fill the container instead of the 68ch reading measure (the AI view). */
  wide?: boolean;
  /** A hairline between the h2 sections (the post page). */
  ruled?: boolean;
}

const { wide = false, ruled = false } = Astro.props;
const measure = wide ? 'max-w-none' : 'max-w-[68ch]';

// Body reads in Inter at 18px since 2026-10-16; headings in Newsreader.
// Wide gaps between paragraphs, a section-opening h2 well apart from the text
// above and close to its own first paragraph (after rubenmarcus.dev, 2026-10-10).
const flow = [
  '[&_p]:mt-paragraph',
  '[&_a]:text-primary [&_a]:underline',
  '[&_strong]:font-bold',
  '[&_:is(h2,h3)]:font-serif',
  '[&_h2]:mt-2xl [&_h2]:text-h2 [&_h2]:font-semibold [&_h2]:leading-tight [&_h2]:text-pretty',
  '[&_h3]:mt-xl [&_h3]:text-h3 [&_h3]:font-semibold [&_h3]:leading-snug',
  '[&_:is(h2,h3)+:is(p,ul,ol,pre,blockquote,.code-block)]:mt-sm',
  // The reset strips list styling; without it a list reads as loose lines.
  '[&_ul]:list-disc [&_ol]:list-decimal [&_:is(ul,ol)]:mt-lg [&_:is(ul,ol)]:pl-lg [&_li]:mt-xs [&_li]:marker:text-muted-foreground',
  '[&_blockquote]:mt-lg [&_blockquote]:border-l-2 [&_blockquote]:border-primary [&_blockquote]:pl-md [&_blockquote]:text-muted-foreground',
  '[&_hr]:my-2xl [&_hr]:border-border',
  // Tables follow the Stitch design (2026-10-19). The frame is a wrapper div
  // (tableFrames in src/lib/markdown/post-plugins.ts) that scrolls, so the
  // table keeps full width and its rules reach the border.
  '[&_.table-frame]:mt-paragraph [&_.table-frame]:overflow-x-auto [&_.table-frame]:rounded-md [&_.table-frame]:border [&_.table-frame]:border-border-strong [&_.table-frame]:bg-surface',
  '[&_table]:w-full [&_table]:border-collapse [&_table]:text-small',
  '[&_:is(th,td)]:px-lg [&_:is(th,td)]:py-md [&_:is(th,td)]:align-middle [&_:is(th,td)]:text-left',
  '[&_th]:font-mono [&_th]:text-caption [&_th]:uppercase [&_th]:tracking-eyebrow [&_th]:font-normal [&_th]:text-muted-foreground [&_th]:bg-surface-elevated [&_th]:border-b [&_th]:border-border',
  '[&_td]:border-b [&_td]:border-border [&_td]:text-muted-foreground [&_tr:last-child>td]:border-b-0',
  // Code in a cell reads as coloured mono, without the inline pill.
  '[&_td>code]:border-0! [&_td>code]:bg-transparent! [&_td>code]:px-0! [&_td>code]:text-success [&_td:first-child>code]:text-primary [&_td:not(:first-child):last-child>code]:text-foreground',
];

// Code blocks come from Shiki with their own colours (measured in
// code-contrast.test.ts); this only frames and spaces them.
const code = [
  '[&_.code-block]:my-lg [&_pre]:my-0 [&_pre]:p-md [&_pre]:pl-sm [&_pre]:font-mono [&_pre]:text-small [&_pre]:leading-normal',
  '[&_:not(pre)>code]:rounded-md [&_:not(pre)>code]:border [&_:not(pre)>code]:border-border-strong [&_:not(pre)>code]:bg-surface-elevated [&_:not(pre)>code]:px-xs [&_:not(pre)>code]:font-mono [&_:not(pre)>code]:text-code-inline',
];
---

<div
  data-prose
  data-prose-ruled={ruled ? '' : undefined}
  class={`${measure} font-sans text-prose text-foreground ${flow.join(' ')} ${code.join(' ')}`}
>
  <slot />
</div>
