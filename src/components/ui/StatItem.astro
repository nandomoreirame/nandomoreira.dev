---
interface Props {
  value: string;
  label: string;
  context: string;
}

const { value, label, context } = Astro.props;

if (!label || !context) {
  throw new Error(
    'StatItem requires both label and context: a bare number misleads (RISK-004).',
  );
}
---

<div class="flex flex-col gap-sm">
  <span class="font-serif text-h1 font-normal tracking-tight text-balance text-primary">{value}</span>
  <span class="text-small font-semibold text-foreground">{label}</span>
  <span class="text-small text-muted-foreground">{context}</span>
</div>
