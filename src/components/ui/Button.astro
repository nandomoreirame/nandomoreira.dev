---
import { Icon } from 'astro-icon/components';

interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  disabled?: boolean;
  label?: string;
  /** Only meaningful on a link; an external target needs its own rel. */
  target?: '_blank';
  rel?: string;
  /** Only meaningful on a link: the file name to save the target as. */
  download?: string;
  /** Only meaningful on a <button>; defaults to "button" so nothing submits by accident. */
  type?: 'button' | 'submit';
  /** Trailing arrow that steps forward on hover, as on the Stitch CTAs. */
  arrow?: boolean;
}

const { href, variant = 'primary', disabled = false, label, target, rel, download, type = 'button', arrow = false } = Astro.props;

const isLink = Boolean(href);
const isDisabledLink = isLink && disabled;

const base = [
  'group/button inline-flex items-center justify-center gap-xs',
  'min-h-11 min-w-11 px-md py-sm',
  'rounded-md text-body font-medium',
  'transition-[transform,opacity,background-color,border-color,box-shadow]',
  'duration-(--duration-fast) ease-out',
  'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary',
  // Real <button disabled> picks these up; disabled links need the unconditional pair below.
  'disabled:cursor-not-allowed disabled:opacity-60',
  isDisabledLink ? 'cursor-not-allowed opacity-60' : '',
]
  .filter(Boolean)
  .join(' ');

const variants = {
  primary: {
    base: 'bg-primary text-primary-foreground',
    interactive: 'hover:opacity-90 hover:shadow-glow active:opacity-80',
  },
  secondary: {
    base: 'border border-border-strong bg-surface text-foreground',
    interactive: 'hover:border-primary hover:bg-surface-elevated active:bg-surface-elevated',
  },
  ghost: {
    base: 'text-foreground',
    interactive: 'hover:bg-surface-elevated hover:text-primary active:opacity-80',
  },
} as const;

const selected = variants[variant];
// Disabled links never match :disabled, so omit hover/active entirely.
const variantClasses = isDisabledLink
  ? selected.base
  : `${selected.base} ${selected.interactive}`;
const className = `${base} ${variantClasses}`;
const Tag = isLink ? 'a' : 'button';
---

<Tag
  class={className}
  href={isDisabledLink ? undefined : href}
  target={isLink ? target : undefined}
  rel={isLink ? rel : undefined}
  download={isLink ? download : undefined}
  role={isDisabledLink ? 'link' : undefined}
  aria-label={label}
  aria-disabled={disabled ? 'true' : undefined}
  disabled={!isLink && disabled ? true : undefined}
  type={isLink ? undefined : type}
>
  <slot />
  {
    arrow && (
      <Icon
        name="lucide:arrow-right"
        aria-hidden="true"
        class="size-4 shrink-0 transition-transform duration-(--duration-fast) ease-out group-hover/button:translate-x-xs"
      />
    )
  }
</Tag>
