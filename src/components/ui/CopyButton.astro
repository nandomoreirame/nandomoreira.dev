---
import { Icon } from 'astro-icon/components';
import { aiViewLabels } from '../../lib/ai-view/labels';
import type { Locale } from '../../lib/i18n/locale';

interface Props {
  /** id of the element whose text is copied. */
  target: string;
  /** Accessible name when the visible label alone is ambiguous on the page. */
  label?: string;
  /** A 44px square with the icon alone; the label stays for screen readers. */
  iconOnly?: boolean;
  /** Visible text; defaults to the AI view's "Copiar". */
  text?: string;
  /** 32px high, caption text: a toolbar beside the reading mode switch. */
  compact?: boolean;
  locale?: Locale;
}

const { target, label, iconOnly = false, compact = false, locale = 'pt-BR' } = Astro.props;
const labels = aiViewLabels(locale);
const text = Astro.props.text ?? labels.copy;

const shape = iconOnly
  ? 'size-11 justify-center text-small'
  : compact
    ? 'min-h-8 gap-xs px-sm text-caption'
    : 'min-h-11 gap-xs px-md text-small';
---

{/* Ships hidden: the site script (PointerField) reveals it and wires the copy,
    so without JavaScript it never promises an action. While confirming, the
    script sets data-copied, which swaps the copy icon for a check. */}
<button
  type="button"
  data-copy={target}
  data-label-copied={labels.copied}
  aria-label={label}
  aria-live="polite"
  hidden
  class={`group/copy inline-flex shrink-0 items-center ${shape} rounded-md border border-border-strong bg-surface font-mono text-foreground transition-[border-color,color,background-color] duration-(--duration-fast) ease-out hover:border-primary hover:bg-surface-elevated hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary`}
>
  <Icon
    name="lucide:copy"
    class={`${compact ? 'size-3.5' : 'size-4'} shrink-0 group-data-copied/copy:hidden`}
    aria-hidden="true"
  />
  <Icon
    name="lucide:check"
    class={`hidden ${compact ? 'size-3.5' : 'size-4'} shrink-0 text-success group-data-copied/copy:block`}
    aria-hidden="true"
  />
  <span class={iconOnly ? 'sr-only' : undefined}>{text}</span>
</button>
