---
import { TITLE_SEPARATOR } from '../../lib/seo/meta';
import ClosingCta from '../catalog/ClosingCta.astro';
import NowGithub from '../now/NowGithub.astro';
import NowGames from '../now/NowGames.astro';
import NowMusic from '../now/NowMusic.astro';
import NowSection from '../now/NowSection.astro';
import AvailabilityCard from '../ui/AvailabilityCard.astro';
import Card from '../ui/Card.astro';
import PageHeader from '../ui/PageHeader.astro';
import TocColumns from '../ui/TocColumns.astro';
import PostTocToggle from '../posts/PostTocToggle.astro';
import TechBadge from '../ui/TechBadge.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllProjects, getProfile } from '../../lib/content';
import { displayNameOf } from '../../lib/content/display-name';
import { toLongDate } from '../../lib/format/date';
import type { Locale } from '../../lib/i18n/locale';
import { withLocale } from '../../lib/i18n/locale';
import { messagesFor } from '../../lib/i18n/messages';
import { postPath } from '../../lib/i18n/paths';
import { saoPauloDay } from '../../lib/now/day';
import { linkForRepo } from '../../lib/now/github';
import { endSentence } from '../../lib/now/sentence';
import { loadNow } from '../../lib/now/load';

interface Props {
  locale?: Locale;
}

const { locale = 'pt-BR' } = Astro.props;
const t = messagesFor(locale).nowPage;

const profile = await getProfile(locale);
const cases = await getAllProjects(locale);
const data = await loadNow(locale);
// Mirrors the NowSection ids and titles below, in order.
const toc = [
  { depth: 2 as const, slug: 'foco', text: t.sections.focus },
  { depth: 2 as const, slug: 'projetos', text: t.sections.working },
  { depth: 2 as const, slug: 'escrevendo', text: t.sections.writing },
  { depth: 2 as const, slug: 'estudando', text: t.sections.studying },
  { depth: 2 as const, slug: 'ouvindo', text: t.sections.listening },
  { depth: 2 as const, slug: 'jogando', text: t.sections.playing },
];
const externalAttrs = { target: '_blank', rel: 'nofollow noopener noreferrer' };
const writing = data.writing;
---

<BaseLayout
  title={`${t.title}${TITLE_SEPARATOR}${displayNameOf(profile)}`}
  description={t.description}
  locale={locale}
>
  <article class="mb-3xl flex flex-col gap-xl">
    <PageHeader title={t.heading} description={t.description} updatedAt={data.updatedAt} locale={locale} />

    <TocColumns items={toc}>
      <NowSection id="foco" title={t.sections.focus} step={1}>
        <AvailabilityCard status={profile.availability.status} detail={profile.availability.detail} locale={locale} />
        <ul>
          {data.focus.items.map((item) => <li>{item}</li>)}
        </ul>
      </NowSection>

      <NowSection id="projetos" title={t.sections.working} step={2}>
          {
            data.projects.state === 'empty' ? (
              <p class="text-muted-foreground">{t.empty}</p>
            ) : (
              <ul>
                {data.projects.items.map((repo) => {
                  const matched = linkForRepo(repo, cases);
                  const href = matched.startsWith('http') ? matched : withLocale(matched, locale);
                  const day = saoPauloDay(new Date(repo.pushedAt));
                  const lead = repo.description ? `: ${endSentence(repo.description)} ` : '. ';
                  return (
                    <li>
                      <a href={href} {...(href.startsWith('http') ? externalAttrs : {})}>{repo.name}</a>{lead}{repo.language && <TechBadge name={repo.language} />}{repo.language ? '. ' : ''}{t.lastPushPrefix} <time datetime={day}>{toLongDate(day, locale)}</time>.
                    </li>
                  );
                })}
              </ul>
            )
          }
          {/* The list first, then the year on GitHub and the last commit in one card. */}
          <NowGithub calendar={data.contributions.state === 'ok' ? data.contributions.items : undefined} commit={data.lastCommit} locale={locale} />
      </NowSection>

      <NowSection id="escrevendo" title={t.sections.writing} step={3}>
          <ul>
            {
              writing.latest && (
                <li>
                  <a href={postPath({ slug: writing.latest.slug, locale })}>{writing.latest.title}</a>
                </li>
              )
            }
            {writing.drafts.map((title) => <li>{title}</li>)}
          </ul>
      </NowSection>

      <NowSection id="estudando" title={t.sections.studying} step={4}>
          <ul>
            {
              data.studying.map((study) => (
                <li>
                  <a href={study.url} {...externalAttrs}>{study.topic}</a>: {study.note}
                </li>
              ))
            }
          </ul>
      </NowSection>

      <NowSection id="ouvindo" title={t.sections.listening} step={5} prose={false}>
        <NowMusic music={data.music} locale={locale} />
      </NowSection>

      <NowSection id="jogando" title={t.sections.playing} step={6} prose={false}>
        <NowGames games={data.games} locale={locale} />
      </NowSection>

      <Card as="aside" class="flex flex-col gap-sm">
        <h2 class="font-mono text-small uppercase tracking-eyebrow text-foreground">{t.whatIsHeading}</h2>
        <p class="text-body text-muted-foreground">
          {t.whatIsBefore}<a href="https://nownownow.com" target="_blank" rel="nofollow noopener noreferrer" class="text-primary underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">{t.whatIsLink}</a>{t.whatIsAfter}
        </p>
      </Card>
    </TocColumns>

    <ClosingCta page="now" locale={locale} />

    <PostTocToggle />
  </article>
</BaseLayout>
