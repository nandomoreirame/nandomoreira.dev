---
import type { Locale } from '../../lib/i18n/locale';
import { salesLabelsFor } from '../../lib/sales/ui';
import { Icon } from 'astro-icon/components';
import type { SalesService, ServiceDetail } from '../../lib/sales/catalog';
import { salesPath } from '../../lib/sales/host';
import SectionIntro from './SectionIntro.astro';

const { locale = 'pt-BR' } = Astro.props;
const t = salesLabelsFor(locale);

interface Props {
  locale?: Locale;
  service: SalesService & { detail: ServiceDetail };
}

const { service } = Astro.props;
const { detail } = service;
const wrap = 'mx-auto flex w-full max-w-page flex-col gap-xl px-lg py-2xl lg:py-3xl';
---

<section aria-labelledby="detalhe-title" class="mx-auto flex w-full max-w-page flex-col gap-lg px-lg py-2xl lg:py-3xl">
  <nav aria-label={t.breadcrumb} class="font-mono text-small text-muted-foreground">
    <a href={`${salesPath(undefined, undefined, locale)}#servicos`} class="hover:text-foreground focus-visible:outline-2 focus-visible:outline-primary">{t.services}</a>
    <span aria-hidden="true"> / </span><span aria-current="page" class="text-foreground">{service.title}</span>
  </nav>
  <h1 id="detalhe-title" class="max-w-narrow font-serif text-display font-normal text-foreground">{detail.hero.title}</h1>
  <p class="max-w-measure text-lead text-muted-foreground">{detail.hero.lead}</p>
  <div class="flex flex-wrap gap-md">
    <a href="#contato" class="inline-flex min-h-11 items-center gap-xs rounded-md bg-primary px-lg text-body font-medium text-primary-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">{detail.hero.cta}<Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" /></a>
    <a href="#incluso" class="inline-flex min-h-11 items-center rounded-md border border-border-strong px-lg text-body text-foreground hover:border-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">{t.showIncluded}</a>
  </div>
</section>

<section aria-labelledby="anatomia-title" class="border-t border-border">
  <div class={wrap}>
    <SectionIntro id="anatomia-title" eyebrow={t.anatomyEyebrow} title={t.anatomyTitle} lead={t.anatomyLead} />
    <ol class="grid gap-md sm:grid-cols-2 lg:grid-cols-4">
      {detail.anatomy.map((part, index) => (
        <li class="flex flex-col gap-sm rounded-md border border-border bg-surface p-lg transition-[border-color] duration-(--duration-base) ease-out hover:border-border-strong">
          <span class="font-mono text-micro uppercase tracking-eyebrow text-primary">{t.part} {String(index + 1).padStart(2, '0')}</span>
          <h3 class="text-h3 font-semibold text-foreground">{part.title}</h3>
          <p class="text-small text-muted-foreground">{part.text}</p>
          <p class="mt-auto border-t border-border pt-sm font-mono text-micro text-muted-foreground">{part.note}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<section aria-labelledby="para-voce-title" class="border-t border-border">
  <div class={wrap}>
    <SectionIntro id="para-voce-title" eyebrow={t.fitEyebrow} title={t.fitTitle} />
    <ul class="grid gap-md md:grid-cols-2">
      {detail.fit.map((item) => (
        <li class="flex flex-col gap-xs rounded-md border border-border bg-surface p-lg transition-[border-color] duration-(--duration-base) ease-out hover:border-border-strong">
          <h3 class="text-body font-semibold text-foreground">{item.title}</h3>
          <p class="text-small text-muted-foreground">{item.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<section id="incluso" aria-labelledby="incluso-title" class="scroll-mt-2xl border-t border-border">
  <div class={wrap}>
    <SectionIntro id="incluso-title" eyebrow={t.includedEyebrow} title={t.includedTitle} />
    <ul class="grid gap-md md:grid-cols-2">
      {detail.included.map((item) => (
        <li class="flex items-start gap-sm rounded-md border border-border bg-surface p-lg transition-[border-color] duration-(--duration-base) ease-out hover:border-border-strong">
          <Icon name="lucide:circle-check" class="mt-xs size-4 shrink-0 text-primary" aria-hidden="true" />
          <div><h3 class="text-body font-semibold text-foreground">{item.title}</h3><p class="text-small text-muted-foreground">{item.text}</p></div>
        </li>
      ))}
    </ul>
  </div>
</section>

<section aria-labelledby="extras-title" class="border-t border-border">
  <div class={wrap}>
    <SectionIntro id="extras-title" eyebrow={t.addonsEyebrow} title={t.addonsTitle} lead={t.addonsLead} />
    <ul class="grid gap-md sm:grid-cols-2 lg:grid-cols-3">
      {detail.addons.map((item) => (
        <li class="flex flex-col gap-xs rounded-md border border-border bg-surface p-lg transition-[border-color] duration-(--duration-base) ease-out hover:border-border-strong">
          <h3 class="text-body font-semibold text-foreground">{item.title}</h3>
          <p class="text-small text-muted-foreground">{item.text}</p>
          <p class="mt-auto pt-sm font-mono text-micro text-muted-foreground">{t.onRequest}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<section aria-labelledby="por-baixo-title" class="border-t border-border">
  <div class={wrap}>
    <SectionIntro id="por-baixo-title" eyebrow={t.infrastructureEyebrow} title={t.infrastructureTitle} />
    <div class="flex max-w-measure flex-col gap-md">
      {detail.underTheHood.map((paragraph) => <p class="text-body text-muted-foreground">{paragraph}</p>)}
    </div>
  </div>
</section>
