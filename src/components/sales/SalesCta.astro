---
import { Icon } from 'astro-icon/components';
import { SALES_COPY } from '../../lib/sales/copy';

interface Props {
  /** Position in SALES_COPY.ctas, so each call on the page has its own copy. */
  index: number;
}

const { index } = Astro.props;
const copy = SALES_COPY.ctas[index]!;
const id = `cta-${index + 1}-title`;
const contact = '#contato';
---

{/* A quote call between the landing sections; it jumps to the form that closes the page. */}
<section data-sales-cta aria-labelledby={id} class="border-t border-border">
  <div class="mx-auto w-full max-w-page px-lg py-xl lg:py-2xl">
    <div class="flex flex-col gap-lg rounded-lg border border-border-strong bg-surface p-lg transition-[border-color] duration-(--duration-base) ease-out hover:border-primary sm:p-xl lg:flex-row lg:items-center lg:justify-between">
      <div class="flex flex-col gap-sm">
        <p class="font-mono text-micro uppercase tracking-eyebrow text-primary">Orçamento sem compromisso</p>
        <h2 id={id} class="font-serif text-h1 font-normal text-pretty text-foreground">{copy.title}</h2>
        <p class="max-w-measure text-body text-muted-foreground">{copy.text}</p>
      </div>
      <a
        href={contact}
        class="inline-flex min-h-11 w-fit shrink-0 items-center gap-xs rounded-md bg-primary px-lg text-body font-medium text-primary-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
      >
        {SALES_COPY.ctaButton}<Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
      </a>
    </div>
  </div>
</section>
