---
import { Icon } from 'astro-icon/components';
import HeroScenery from './HeroScenery.astro';

/**
 * Decorative: three stacked browser windows (site, store, panel), no figures,
 * no client names, over the scenery of what the page sells (HeroScenery).
 */
const bar = 'flex items-center gap-xs border-b border-border px-md py-sm';
const dot = 'size-2 rounded-full bg-border-strong';
/** Product cards in the store window: a thumbnail, a name, a line of copy and the price. */
const PRODUCTS = [
  { title: 'w-3/4', line: 'w-1/2' },
  { title: 'w-2/3', line: 'w-3/4' },
  { title: 'w-5/6', line: 'w-2/3' },
];
---

<div class="relative hidden lg:block">
<HeroScenery />
<div data-hero-art data-parallax data-tilt style="--depth: 0.02" aria-hidden="true" class="relative rounded-lg border border-border bg-surface p-lg">
  <div data-parallax style="--depth: 0.035" class="rounded-md border border-border bg-surface-elevated shadow-window transition-[border-color] duration-(--duration-base) ease-out hover:border-border-strong">
    <div class={bar}><span class={dot}></span><span class={dot}></span><span class={dot}></span></div>
    <div class="flex flex-col gap-sm p-md">
      <span class="h-2 w-1/3 rounded-sm bg-primary"></span>
      <span class="h-2 w-3/4 rounded-sm bg-border-strong"></span>
      <span class="h-2 w-2/3 rounded-sm bg-border"></span>
    </div>
  </div>
  <div data-parallax style="--depth: 0.055" class="relative z-10 -mt-md ml-xl rounded-md border border-border bg-surface-elevated shadow-window transition-[border-color] duration-(--duration-base) ease-out hover:border-border-strong">
    <div class={bar}><span class="font-mono text-micro text-muted-foreground">loja / vitrine</span></div>
    <div class="grid grid-cols-3 gap-sm p-md">
      {PRODUCTS.map((product) => (
        <div class="flex flex-col gap-xs rounded-sm bg-surface p-xs">
          <span class="flex aspect-video items-center justify-center rounded-sm bg-border">
            <Icon name="lucide:image" class="size-4 text-border-strong" />
          </span>
          <span class={`mt-xs h-2 rounded-sm bg-border-strong ${product.title}`}></span>
          <span class={`h-1.5 rounded-sm bg-border ${product.line}`}></span>
          <span class="mt-xs flex items-center justify-between gap-xs">
            <span class="h-2 w-1/3 rounded-sm bg-primary"></span>
            <span class="size-3 rounded-sm border border-border-strong"></span>
          </span>
        </div>
      ))}
    </div>
  </div>
  <div data-parallax style="--depth: 0.08" class="-mt-sm rounded-md border border-border bg-surface-elevated p-md shadow-window transition-[border-color] duration-(--duration-base) ease-out hover:border-primary">
    <p class="font-mono text-micro text-muted-foreground">painel</p>
    <div class="mt-sm flex items-end gap-sm">
      <span class="h-4 flex-1 rounded-sm bg-border"></span>
      <span class="h-6 flex-1 rounded-sm bg-border"></span>
      <span class="h-8 flex-1 rounded-sm bg-primary"></span>
      <span class="h-5 flex-1 rounded-sm bg-border"></span>
    </div>
  </div>
</div>
</div>
